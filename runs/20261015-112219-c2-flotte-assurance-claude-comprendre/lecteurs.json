{
  "perimetre": {
    "perimetre": "dans",
    "raison": "Le cœur du projet est un outil de gestion de parc automobile pour un cabinet d'assurance. Il comporte des fiches (souscripteurs, contrats, immatriculations en fiches enfants) et deux rôles qui se connectent : l'administrateur crée, modifie et supprime les souscripteurs et les flottes, et chaque souscripteur gère sa propre flotte. Le PDF de carte verte, les e-mails, l'import et l'export Excel, le filtre d'affichage et la contrainte d'hébergement sont des besoins hors stock.",
    "hors_stock": [
      {
        "besoin": "Génération en PDF d'une carte verte à imprimer, avec un contenu imposé (modèle dans un PDF joint)",
        "categorie": "document",
        "citation": "permettre d’imprimer une carte verte (vie génération pdf)... La carte verte doit contenir les infos suivantes (voir PDF joint)"
      },
      {
        "besoin": "Envoi automatique d'un e-mail à l'agence et au client à chaque action (sauf l'impression de la carte verte)",
        "categorie": "notification",
        "citation": "Lors de chaque action (sauf impression carte verte), un mail doit être envoyé à l’agence et au client."
      },
      {
        "besoin": "Import d'un fichier Excel par l'administrateur pour alimenter la flotte",
        "categorie": "autre",
        "citation": "Avec possibilité d’import fichier excel pour alimenter la flotte"
      },
      {
        "besoin": "Export du parc de véhicules vers Excel",
        "categorie": "autre",
        "citation": "possibilité export parc sur excel"
      },
      {
        "besoin": "Filtre d'affichage des véhicules selon qu'ils sont sortis ou non",
        "categorie": "autre",
        "citation": "possibilité de filtrer l’affichage des véhicules si sortis ou non"
      },
      {
        "besoin": "Contrainte technique : application en PHP/MySQL installable sur un hébergement mutualisé OVH",
        "categorie": "autre",
        "citation": "Interface php/mysql pouvant être installé sur hébergement mutualisé OVH."
      }
