generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id              // Clerk userId (ex: user_xxx)
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}


enum TaskPriority {
  low
  medium
  high
}

model Task {
  id String @id @default(uuid())
  title String
  description String?
  priority TaskPriority
  dueDate DateTime?
  userId String
  createdAt DateTime @default(now())
}
