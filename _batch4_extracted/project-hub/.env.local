# Clerk — récupérer sur https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Clerk — URLs de navigation (Clerk v6)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Base de données — Neon (ou autre PostgreSQL)
# DATABASE_URL     : URL poolée (PgBouncer) — utilisée par Prisma Client à runtime
# DIRECT_DATABASE_URL : URL directe (non poolée) — requise pour prisma db push / migrate
DATABASE_URL=postgresql://user:password@hostname/project-hub?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@hostname-direct/project-hub?sslmode=require
