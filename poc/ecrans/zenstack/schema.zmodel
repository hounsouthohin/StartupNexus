// E6 — médiathèque (matrice de référence harness/matrices/mediatheque), traduite avec les patrons
// des études 03 et 04 : rôles LISTÉS (jamais « tout connecté »), clôture à la création,
// propriétaire immuable, une règle par flèche du circuit.

datasource db {
    provider = 'postgresql'
    url      = env('DATABASE_URL')
}

plugin policy {
    provider = '@zenstackhq/plugin-policy'
}

type Auth {
    id   String @id
    role String
    @@auth
}

// catalogue public, géré par personne (lecture seule ; contenu = données de départ)
model Book {
    id         String      @id @default(cuid())
    title      String
    author     String
    borrowings Borrowing[]

    @@allow('read', true)
}

// profil de l'adhérent, créé à sa première visite
model Member {
    id         String      @id @default(cuid())
    userId     String      @unique @default(auth().id)
    name       String
    email      String
    phone      String?
    borrowings Borrowing[]

    @@allow('create', auth().role == 'adherent' && userId == auth().id)
    @@allow('read,update', auth().role == 'adherent' && userId == auth().id)
    @@allow('read', auth().role == 'bibliothecaire' && borrowings?[true])   // vu au travers des emprunts
    @@deny('post-update', userId != before().userId)
}

enum BorrowingStatus {
    requested
    accepted
    refused
    returned
}

// collection de l'adhérent ; circuit : l'adhérent demande, le bibliothécaire décide
model Borrowing {
    id        String          @id @default(cuid())
    ownerId   String          @default(auth().id)
    member    Member          @relation(fields: [ownerId], references: [userId])
    bookId    String
    book      Book            @relation(fields: [bookId], references: [id])
    status    BorrowingStatus @default(requested)
    createdAt DateTime        @default(now())

    @@allow('read', auth().role == 'adherent' && ownerId == auth().id)
    @@allow('read', auth().role == 'bibliothecaire')
    @@allow('create', auth().role == 'adherent' && ownerId == auth().id && status == requested && check(book, 'read'))
    @@allow('update', auth().role == 'bibliothecaire')
    @@allow('post-update', auth().role == 'bibliothecaire' && before().status == requested && (status == accepted || status == refused) && bookId == before().bookId)
    @@allow('post-update', auth().role == 'bibliothecaire' && before().status == accepted && status == returned && bookId == before().bookId)
    @@deny('post-update', ownerId != before().ownerId)
}
