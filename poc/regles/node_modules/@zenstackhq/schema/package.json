{
  "name": "@zenstackhq/schema",
  "displayName": "ZenStack Schema Object Model",
  "description": "TypeScript representation of ZModel schema",
  "version": "3.9.7",
  "type": "module",
  "author": {
    "name": "ZenStack Team",
    "email": "contact@zenstack.dev"
  },
  "homepage": "https://zenstack.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenstackhq/zenstack"
  },
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": {
      "import": "./package.json",
      "require": "./package.json"
    }
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@zenstackhq/tsdown-config": "3.9.7",
    "@zenstackhq/typescript-config": "3.9.7",
    "@zenstackhq/vitest-config": "3.9.7",
    "@zenstackhq/eslint-config": "3.9.7"
  },
  "funding": "https://github.com/sponsors/zenstackhq",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "watch": "tsdown --watch",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "pack": "pnpm pack",
    "test:generate": "tsx ../../scripts/test-generate.ts ."
  }
}