{
  "name": "@zenstackhq/orm",
  "displayName": "ZenStack ORM",
  "description": "ZenStack ORM",
  "version": "3.9.7",
  "type": "module",
  "author": {
    "name": "ZenStack Team",
    "email": "contact@zenstack.dev"
  },
  "homepage": "https://zenstack.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenstackhq/zenstack"
  },
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.mts",
        "default": "./dist/schema.mjs"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      }
    },
    "./dialects/sqlite": {
      "import": {
        "types": "./dist/dialects/sqlite.d.mts",
        "default": "./dist/dialects/sqlite.mjs"
      },
      "require": {
        "types": "./dist/dialects/sqlite.d.cts",
        "default": "./dist/dialects/sqlite.cjs"
      }
    },
    "./dialects/postgres": {
      "import": {
        "types": "./dist/dialects/postgres.d.mts",
        "default": "./dist/dialects/postgres.mjs"
      },
      "require": {
        "types": "./dist/dialects/postgres.d.cts",
        "default": "./dist/dialects/postgres.cjs"
      }
    },
    "./dialects/mysql": {
      "import": {
        "types": "./dist/dialects/mysql.d.mts",
        "default": "./dist/dialects/mysql.mjs"
      },
      "require": {
        "types": "./dist/dialects/mysql.d.cts",
        "default": "./dist/dialects/mysql.cjs"
      }
    },
    "./dialects/sql.js": {
      "import": {
        "types": "./dist/dialects/sql.js.d.mts",
        "default": "./dist/dialects/sql.js.mjs"
      },
      "require": {
        "types": "./dist/dialects/sql.js.d.cts",
        "default": "./dist/dialects/sql.js.cjs"
      }
    },
    "./helpers": {
      "import": {
        "types": "./dist/helpers.d.mts",
        "default": "./dist/helpers.mjs"
      },
      "require": {
        "types": "./dist/helpers.d.cts",
        "default": "./dist/helpers.cjs"
      }
    },
    "./common-types": {
      "import": {
        "types": "./dist/common-types.d.mts",
        "default": "./dist/common-types.mjs"
      },
      "require": {
        "types": "./dist/common-types.d.cts",
        "default": "./dist/common-types.cjs"
      }
    },
    "./package.json": {
      "import": "./package.json",
      "require": "./package.json"
    }
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "cuid": "^3.0.0",
    "decimal.js": "^10.4.3",
    "json-stable-stringify": "^1.3.0",
    "kysely": "~0.29.0",
    "nanoid": "^5.0.9",
    "postgres-array": "^3.0.4",
    "toposort": "^2.0.2",
    "ts-pattern": "^5.7.1",
    "ulid": "^3.0.0",
    "uuid": "^11.0.5",
    "zod-validation-error": "^4.0.1",
    "@zenstackhq/common-helpers": "3.9.7",
    "@zenstackhq/zod": "3.9.7",
    "@zenstackhq/schema": "3.9.7"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.5.0",
    "pg": "^8.13.1",
    "mysql2": "^3.16.1",
    "sql.js": "^1.13.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "sql.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/toposort": "^2.0.7",
    "tsx": "^4.22.0",
    "zod": "^4.1.0",
    "@zenstackhq/eslint-config": "3.9.7",
    "@zenstackhq/tsdown-config": "3.9.7",
    "@zenstackhq/typescript-config": "3.9.7",
    "@zenstackhq/vitest-config": "3.9.7"
  },
  "funding": "https://github.com/sponsors/zenstackhq",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "watch": "tsdown --watch",
    "lint": "eslint src --ext ts",
    "pack": "pnpm pack",
    "test:generate": "tsx ../../scripts/test-generate.ts . --generate-models"
  }
}