{
  "name": "@zenstackhq/cli",
  "displayName": "ZenStack CLI",
  "description": "FullStack database toolkit with built-in access control and automatic API generation.",
  "version": "3.9.7",
  "type": "module",
  "author": {
    "name": "ZenStack Team",
    "email": "contact@zenstack.dev"
  },
  "homepage": "https://zenstack.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenstackhq/zenstack"
  },
  "license": "MIT",
  "keywords": [
    "orm",
    "fullstack",
    "react",
    "typescript",
    "data modeling"
  ],
  "bin": {
    "zen": "bin/cli",
    "zenstack": "bin/cli"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    "./package.json": {
      "import": "./package.json",
      "require": "./package.json"
    },
    "./proxy": {
      "import": {
        "types": "./dist/proxy.d.mts",
        "default": "./dist/proxy.mjs"
      },
      "require": {
        "types": "./dist/proxy.d.cts",
        "default": "./dist/proxy.cjs"
      }
    }
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.11.10",
    "chokidar": "^5.0.0",
    "colors": "1.4.0",
    "commander": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "execa": "^9.6.0",
    "jiti": "^2.6.1",
    "langium": "4.2.4",
    "mixpanel": "^0.18.1",
    "ora": "^5.4.1",
    "package-manager-detector": "^1.3.0",
    "prisma": "^6.19.0",
    "semver": "^7.7.2",
    "terminal-link": "^5.0.0",
    "ts-pattern": "^5.7.1",
    "zod": "^4.0.0",
    "@zenstackhq/language": "3.9.7",
    "@zenstackhq/schema": "3.9.7",
    "@zenstackhq/orm": "3.9.7",
    "@zenstackhq/sdk": "3.9.7",
    "@zenstackhq/plugin-policy": "3.9.7",
    "@zenstackhq/server": "3.9.7",
    "@zenstackhq/common-helpers": "3.9.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.16.0",
    "@types/semver": "^7.7.0",
    "@types/tmp": "^0.2.6",
    "tmp": "^0.2.4",
    "@zenstackhq/eslint-config": "3.9.7",
    "@zenstackhq/testtools": "3.9.7",
    "@zenstackhq/tsdown-config": "3.9.7",
    "@zenstackhq/typescript-config": "3.9.7",
    "@zenstackhq/vitest-config": "3.9.7"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.5.0",
    "mysql2": "^3.16.1",
    "pg": "^8.13.1"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "funding": "https://github.com/sponsors/zenstackhq",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "watch": "tsdown --watch",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "pack": "pnpm pack"
  }
}