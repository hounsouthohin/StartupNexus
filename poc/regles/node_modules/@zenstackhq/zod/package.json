{
  "name": "@zenstackhq/zod",
  "displayName": "ZenStack Zod Integration",
  "description": "Automatically deriving Zod schemas from ZModel schemas",
  "version": "3.9.7",
  "type": "module",
  "author": {
    "name": "ZenStack Team",
    "email": "contact@zenstack.dev"
  },
  "homepage": "https://zenstack.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenstackhq/zenstack"
  },
  "license": "MIT",
  "keywords": [
    "zenstack",
    "zod"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "@zenstackhq/schema": "3.9.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "zod": "^4.1.0",
    "@zenstackhq/eslint-config": "3.9.7",
    "@zenstackhq/tsdown-config": "3.9.7",
    "@zenstackhq/typescript-config": "3.9.7",
    "@zenstackhq/vitest-config": "3.9.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "funding": "https://github.com/sponsors/zenstackhq",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "watch": "tsdown --watch",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "pack": "pnpm pack",
    "test:generate": "tsx ../../scripts/test-generate.ts . --lite"
  }
}