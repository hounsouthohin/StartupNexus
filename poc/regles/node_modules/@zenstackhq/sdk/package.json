{
  "name": "@zenstackhq/sdk",
  "displayName": "ZenStack SDK",
  "description": "Utilities for building ZenStack plugins",
  "version": "3.9.7",
  "type": "module",
  "author": {
    "name": "ZenStack Team",
    "email": "contact@zenstack.dev"
  },
  "homepage": "https://zenstack.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenstackhq/zenstack"
  },
  "license": "MIT",
  "keywords": [],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ast": {
      "import": {
        "types": "./dist/ast.d.mts",
        "default": "./dist/ast.mjs"
      },
      "require": {
        "types": "./dist/ast.d.cts",
        "default": "./dist/ast.cjs"
      }
    }
  },
  "dependencies": {
    "langium": "4.2.4",
    "ts-pattern": "^5.7.1",
    "typescript": "^6.0.3",
    "@zenstackhq/language": "3.9.7",
    "@zenstackhq/common-helpers": "3.9.7"
  },
  "devDependencies": {
    "decimal.js": "^10.4.3",
    "kysely": "~0.29.0",
    "@types/node": "^20.19.0",
    "@zenstackhq/eslint-config": "3.9.7",
    "@zenstackhq/tsdown-config": "3.9.7",
    "@zenstackhq/typescript-config": "3.9.7"
  },
  "funding": "https://github.com/sponsors/zenstackhq",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "watch": "tsdown --watch",
    "lint": "eslint src --ext ts",
    "pack": "pnpm pack"
  }
}