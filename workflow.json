{
  "name": "Start SaaS Factory - Déclenchement usine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "start-saas",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
    },
    {
      "parameters": {
        "authentication": "none",
        "requestMethod": "POST",
        "url": "http://localhost:5000/start-saas",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ { \"phrase\": $json.body.phrase || \"SaaS inconnu\" } }}"
      },
      "name": "Call Factory API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $node[\"Call Factory API\"].json[\"message\"] }}",
              "operation": "contains",
              "value2": "Factory lancée"
            }
          ]
        }
      },
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "options": {},
        "responseBody": "={{ $json }}"
      },
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 240]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 500,
        "options": {},
        "responseBody": "={{ { \"error\": $node[\"Call Factory API\"].json[\"error\"] || \"Erreur inconnue\" } }}"
      },
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 360]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Call Factory API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Factory API": {
      "main": [
        [
          {
            "node": "Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success?": {
      "main": [
        [
          {
            "node": "Success Response",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}