generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecipeStatus {
  draft
  published
  archived
}

model Recipe {
  id String @id @default(uuid())
  title String
  description String
  slug String @unique
  status RecipeStatus @default(draft)
  authorId String
  createdAt DateTime @default(now())
}

model Category {
  id String @id @default(uuid())
  name String
  authorId String
  createdAt DateTime @default(now())
}
