{
  "id": "nextjs-clerk-prisma",
  "stack_id": "nextjs-clerk-prisma",
  "display_name": "Next.js 14 + Clerk v6 + Prisma 7",
  "status": "stable",
  "framework": "nextjs",
  "description": "Next.js 14 App Router + Clerk V6 + Prisma 7 — stack Sprint 0-3",

  "packages": {
    "next": "14.2.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@clerk/nextjs": "^6.0.0",
    "prisma": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "typescript": "^5.3.3"
  },

  "dev_packages": {
    "ts-jest": "29.1.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@babel/runtime": "^7.0.0",
    "node-mocks-http": "^1.14.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.2.25"
  },

  "peer_dependency_minimums": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },

  "version_pins": {
    "next": "14.2.25",
    "typescript": "^5.3.3"
  },

  "forbidden_paths": [
    "pages/",
    "src/pages/"
  ],

  "forbidden_imports": [
    "bcrypt",
    "jsonwebtoken",
    "password_hash",
    "passport",
    "next-auth",
    "nextauth",
    "/api/auth/register",
    "/api/auth/login",
    "shadcn/ui"
  ],
  "forbidden_auth_patterns": [
    "bcrypt",
    "jwt",
    "jsonwebtoken",
    "password_hash",
    "next-auth",
    "nextauth",
    "/api/auth/register",
    "/api/auth/login",
    "password field",
    "oauth 2.0",
    "oauth2",
    "passport",
    "express-session",
    "cookie-session"
  ],
  "prompt_rules": {
    "package_scripts": {
      "build": "next build",
      "dev": "next dev",
      "start": "next start",
      "lint": "next lint",
      "test": "jest"
    },
    "auth_rules": [
      "Clerk exclusif pour auth (INTERDIT: bcrypt, NextAuth, JWT custom, Passport)",
      "Implementer ClerkProvider dans app/layout.tsx",
      "Creer middleware.ts avec clerkMiddleware() et createRouteMatcher",
      "NE PAS generer app/api/auth/route.ts : Clerk gere ses propres routes"
    ],
    "ui_rules": [
      "UI avec Tailwind CSS uniquement",
      "INTERDIT: shadcn/ui, @radix-ui, @headlessui, librairies de composants externes",
      "INTERDIT: import depuis @/components/ui/*"
    ],
    "orm_rules": [
      "Prisma pour la base de donnees (schema.prisma)",
      "Utiliser clerkId (String) et INTERDIT: champ password",
      "Executer prisma_migrate apres ecriture de schema.prisma"
    ],
    "security_rules": [
      "Validation Zod sur toutes les entrees utilisateur",
      "Pas de secrets en dur - utiliser .env.local"
    ],
    "test_rules": [
      "Toujours mocker Clerk dans les tests React via jest.mock('@clerk/nextjs', ...)",
      "Utiliser jest.mock('@clerk/nextjs/server') pour les tests API Routes",
      "Utiliser node-mocks-http pour les tests de Route Handlers"
    ],
    "qa_rules": [
      "Tester la navigation vers /sign-in (Clerk)",
      "Valider la redirection post-auth vers /dashboard",
      "URL de base: process.env.BASE_URL || 'http://localhost:3000'"
    ]
  },
  "templates_folder": "config/stacks/nextjs-clerk-prisma/templates",
  "template_files": {
    "next.config.js": "next.config.js",
    "tsconfig.json": "tsconfig.json",
    "env.local": "env.local.template",
    "middleware.ts": "middleware.ts",
    "jest.config.js": "jest.config.js",
    ".babelrc": "babelrc.template"
  },
  "technology_categories": {
    "auth": ["clerk", "clerkprovider", "clerkmiddleware"],
    "database": ["prisma", "schema.prisma", "prisma_migrate"],
    "testing": ["jest", "test", "testing-library", "node-mocks-http"],
    "framework": ["next", "middleware", "app router", "layout.tsx"],
    "ui": ["tailwind", "shadcn", "radix"]
  },

  "import_remaps": {
    "package_fixes": {
      "@clerk/clerk-sdk": "@clerk/nextjs",
      "@clerk/clerk-js": "@clerk/nextjs",
      "@clerk/sdk": "@clerk/nextjs",
      "@clerk/react": "@clerk/nextjs"
    },
    "source_fixes": {
      "@clerk/clerk-sdk": "@clerk/nextjs",
      "@clerk/clerk-sdk-react": "@clerk/nextjs",
      "@clerk/nextjs/api": "@clerk/nextjs/server",
      "@clerk/nextjs/middleware": "@clerk/nextjs/server"
    },
    "test_fixes": {
      "@clerk/clerk-sdk": "@clerk/nextjs",
      "@clerk/nextjs/api": "@clerk/nextjs/server",
      "@clerk/nextjs/middleware": "@clerk/nextjs/server"
    },
    "router_fixes": {
      "next/router": "next/navigation"
    }
  },

  "blueprint": {
    "required_files": [
      "package.json",
      "next.config.js",
      "tsconfig.json",
      "app/layout.tsx",
      "middleware.ts",
      "schema.prisma",
      ".env.local"
    ],
    "critical_files": [
      "package.json",
      "next.config.js",
      "tsconfig.json",
      "app/layout.tsx",
      "middleware.ts",
      "schema.prisma",
      ".env.local"
    ],
    "optional_files": [
      "app/page.tsx",
      "jest.config.js"
    ]
  },

  "sanitizers": [
    "remove_pages_conflicts",
    "clerk_middleware_v5",
    "remove_problematic_babel",
    "ensure_nextconfig",
    "ensure_tsconfig_paths",
    "ensure_env_local"
  ],

  "build_hooks": {
    "pre_build": [
      "_remove_pages_router_conflicts",
      "_remove_problematic_babel_config",
      "_ensure_nextconfig_eslint_ignore",
      "validate_blueprint"
    ]
  },

  "commands": {
    "install": "npm install",
    "install_legacy": "npm install --legacy-peer-deps",
    "build": "npm run build",
    "test": "npx jest --coverage",
    "prisma_migrate": "npx prisma migrate dev"
  },
  "testing": {
    "min_required_tests": 1,
    "allow_zero_tests_debug": false,
    "cleanup_stale_tests": "always"
  },
  "mandatory_rag_queries": [
    "versions exactes next.js clerk prisma tailwind zod",
    "clerk next.js 14 app/layout ClerkProvider middleware.ts clerkMiddleware createRouteMatcher sign-in sign-up routes interdites",
    "prisma clerkId sans password schema conventions"
  ],

  "qdrant_filter": {
    "collection": "factory_standards",
    "filter": {
      "should": [
        {"key": "stack", "match": {"value": "nextjs-clerk-prisma"}},
        {"key": "stack", "match": {"value": "nextjs"}},
        {"key": "stack", "match": {"value": "clerk"}}
      ]
    }
  },

  "compatibility_matrix": {
    "ts-jest": {
      "required_major": 29,
      "reason": "ts-jest@27/28 incompatible avec TypeScript>=5.x",
      "incompatible_with": {
        "jest": ">=30"
      }
    },
    "next": {
      "min_major": 14,
      "max_major": 14,
      "reason": "next@15+ incompatible avec Clerk V5 App Router Sprint 0-3"
    },
    "jest": {
      "required_major": 29,
      "reason": "jest@30 incompatible avec ts-jest@29"
    }
  }
  ,
  "test_import_rules": {
    "app_router_api": "import { handler } from '../../app/api/{name}/route'",
    "middleware": "import middleware from '../../middleware'"
  }
}
