{
  "id": "nextjs-clerk-prisma",
  "stack_id": "nextjs-clerk-prisma",
  "display_name": "Next.js 14 + Clerk v6 + Prisma 7",
  "status": "stable",
  "framework": "nextjs",
  "llm_models": {
    "architect_base": "gpt-4o-mini",
    "architect_planner": "gpt-4o"
  },
  "description": "Next.js 14 App Router + Clerk V6 + Prisma 7 — stack Sprint 0-3",
  "root_file": "package.json",
  "primary_manifest": "package.json",
  "cleanup_artifacts": [
    ".next",
    "node_modules"
  ],
  "workdir_keep_extra": [
    ".npm"
  ],
  "token_budgets": {
    "phase1_tokens": 6000,
    "phase2_tokens": 14000
  },
  "iteration_policy": {
    "base_max_iterations": 14,
    "max_cap_iterations": 24,
    "tiers": [
      {
        "min_requirements": 11,
        "max_iterations": 17
      },
      {
        "min_requirements": 16,
        "max_iterations": 20
      },
      {
        "min_requirements": 22,
        "max_iterations": 24
      }
    ]
  },
  "generation_order": {
    "priority_paths": [
      "app/page.tsx",
      "app/api/"
    ]
  },
  "packages": {
    "next": "14.2.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@clerk/nextjs": "^6.0.0",
    "prisma": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.13.0",
    "typescript": "^5.3.3",
    "zod": "^3.23.8"
  },
  "dev_packages": {
    "ts-jest": "29.1.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@babel/runtime": "^7.0.0",
    "node-mocks-http": "^1.14.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.2.25"
  },
  "peer_dependency_minimums": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "version_pins": {
    "next": "14.2.25",
    "typescript": "^5.3.3"
  },
  "forbidden_paths": [
    "pages/",
    "src/pages/"
  ],
  "forbidden_imports": [
    "bcrypt",
    "jsonwebtoken",
    "password_hash",
    "passport",
    "next-auth",
    "nextauth",
    "authMiddleware",
    "/api/auth/register",
    "/api/auth/login",
    "shadcn/ui",
    "@shadcn/ui",
    "react-hook-form"
  ],
  "forbidden_auth_patterns": [
    "bcrypt",
    "jwt",
    "jsonwebtoken",
    "password_hash",
    "next-auth",
    "nextauth",
    "/api/auth/register",
    "/api/auth/login",
    "password field",
    "oauth 2.0",
    "oauth2",
    "passport",
    "express-session",
    "cookie-session"
  ],
  "prompt_rules": {
    "extraction_rules": [
      "Chaque modele Prisma mentionne dans le brief doit apparaitre dans data_models.",
      "Chaque champ et contrainte explicite d'un modele Prisma du brief doit etre conserve a l'identique.",
      "Chaque page demandee dans le brief doit apparaitre dans pages avec son chemin exact.",
      "Chaque route API demandee dans le brief doit apparaitre dans api_routes avec methode et chemin exacts.",
      "requirements[] doit contenir un item explicite pour chaque modele, page, route et feature demandes.",
      "La spec doit rester metier et specifique au brief; les specs auth-only generiques sont interdites."
    ],
    "package_scripts": {
      "build": "next build",
      "dev": "next dev",
      "start": "next start",
      "lint": "next lint",
      "test": "jest"
    },
    "auth_rules": [
      "Auth stack: Clerk uniquement; interdits: bcrypt, NextAuth, JWT custom, Passport, authMiddleware.",
      "app/layout.tsx doit envelopper <html> avec <ClerkProvider>.",
      "middleware.ts (racine) doit importer clerkMiddleware depuis @clerk/nextjs/server.",
      "Dans server components et route handlers, auth() doit toujours etre await.",
      "Dans app/api/**/route.ts, si authorId utilise userId, ajouter `if (!userId) return 401` avant Prisma.",
      "Dans client components ('use client'), interdiction d'importer @clerk/nextjs/server.",
      "useAuth() ne doit jamais etre utilise pour lire l'objet user; utiliser useUser()."
    ],
    "ui_rules": [
      "UI: Tailwind CSS uniquement.",
      "Librairies UI externes interdites: shadcn/ui, @radix-ui, @headlessui.",
      "Imports depuis @/components/ui/* interdits.",
      "Import depuis '@/types' interdit; utiliser types locaux ou fichier adjacent.",
      "Callbacks map/filter/reduce doivent avoir des types explicites si inference absente.",
      "En TypeScript strict, useState([]) sans type générique est interdit; typer explicitement les tableaux (ex: useState<PostSummary[]>([])).",
      "Dans app/** (App Router), getServerSideProps/getStaticProps/getStaticPaths sont interdits.",
      "Tout fichier app/*.tsx utilisant un hook React doit commencer par \"use client\"; sinon convertir en Server Component sans hooks."
    ],
    "orm_rules": [
      "Le schema Prisma autorise est prisma/schema.prisma; prisma.config.ts reste template de stack.",
      "schema.prisma DOIT contenir datasource db avec provider = \"postgresql\".",
      "Prisma 7: datasource db dans schema.prisma ne doit pas declarer url = env(...).",
      "generator client doit utiliser provider = \"prisma-client-js\".",
      "lib/prisma.ts doit instancier PrismaClient avec PrismaPg adapter.",
      "Dans app/api/**/route.*, l'acces Prisma doit passer par import prisma from '@/lib/prisma'.",
      "Tous les champs et contraintes Prisma demandes par le requirement sont obligatoires a l'identique."
    ],
    "security_rules": [
      "Toutes les entrees utilisateur doivent etre validees avec Zod.",
      ".env.local doit contenir NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY et DATABASE_URL.",
      "NEXT_PUBLIC_CLERK_SECRET_KEY est interdit.",
      "Pattern canonique TOUT handler (GET, POST, PUT, PATCH, DELETE) utilisant userId : const { userId } = await auth(); if (!userId) return NextResponse.json({ error: 'Unauthorized' }, { status: 401 }); — obligatoire avant toute operation Prisma utilisant userId (findMany, findUnique, create, update, delete). Cela inclut les GET qui filtrent par where: { authorId: userId }."
    ],
    "test_rules": [
      "jest.config.js doit etre base sur next/jest (createJestConfig).",
      "jest.config.js doit declarer setupFilesAfterEnv avec <rootDir>/jest.setup.js.",
      "jest.setup.js ne contient que import '@testing-library/jest-dom'.",
      "Tests React: mocks Clerk client via @clerk/nextjs.",
      "Tests API routes: mocks Clerk server via @clerk/nextjs/server.",
      "Tests de route handlers: utiliser node-mocks-http."
    ],
    "qa_rules": [
      "Tester la navigation vers /sign-in (Clerk)",
      "Valider la redirection post-auth vers /dashboard",
      "URL de base: process.env.BASE_URL || 'http://localhost:3000'"
    ]
  },
  "spec_validation": {
    "required_keywords": [
      "next.js",
      "clerk",
      "prisma"
    ],
    "forbidden_keywords": [
      "oauth 2.0",
      "oauth2",
      "express.js",
      "flask",
      "mongodb",
      "angular",
      "react.js or",
      "microservices",
      "@clerk/nextjs/api",
      "nextapirequest",
      "nextapiresponse",
      "authMiddleware",
      "pages/api/",
      "clerkmiddleware } from '@clerk/nextjs'",
      "createroutematcher } from '@clerk/nextjs'"
    ],
    "required_sections": [
      "## vue d'ensemble",
      "## stack technique",
      "## structure des pages",
      "## schéma prisma",
      "## authentification clerk",
      "## api routes",
      "## composants tailwind"
    ]
  },
  "technology_categories": {
    "auth": [
      "clerk",
      "clerkprovider",
      "clerkmiddleware"
    ],
    "database": [
      "prisma",
      "schema.prisma",
      "prisma_migrate"
    ],
    "testing": [
      "jest",
      "test",
      "testing-library",
      "node-mocks-http"
    ],
    "framework": [
      "next",
      "middleware",
      "app router",
      "layout.tsx"
    ],
    "ui": [
      "tailwind",
      "shadcn",
      "radix"
    ]
  },
  "templated_files": {
    "package.json": "templates/package.json",
    "middleware.ts": "templates/middleware.ts",
    "app/layout.tsx": "templates/app_layout.tsx",
    "app/globals.css": "templates/app_globals.css",
    "jest.config.js": "templates/jest.config.js",
    "jest.setup.js": "templates/jest.setup.js",
    "next.config.js": "templates/next.config.js",
    "tsconfig.json": "templates/tsconfig.json",
    ".env.local": "templates/env.local.template",
    "tests/middleware.test.ts": "templates/tests/middleware.test.ts",
    "lib/prisma.ts": "templates/lib_prisma.ts",
    "prisma.config.ts": "templates/prisma_config.ts",
    "prisma/schema.prisma": "templates/prisma_schema.prisma"
  },
  "scaffold_extends": {
    "prisma/schema.prisma": {
      "template": "templates/prisma_schema.prisma",
      "locked_until_keyword": "model "
    }
  },
  "blueprint": {
    "required_files": [
      "package.json",
      "next.config.js",
      "tsconfig.json",
      "app/layout.tsx",
      "app/globals.css",
      "middleware.ts",
      "prisma/schema.prisma",
      "prisma.config.ts",
      ".env.local",
      "lib/prisma.ts",
      "app/page.tsx",
      "jest.config.js",
      "jest.setup.js"
    ],
    "critical_files": [
      "package.json",
      "next.config.js",
      "tsconfig.json",
      "app/layout.tsx",
      "middleware.ts",
      "prisma/schema.prisma",
      ".env.local",
      "lib/prisma.ts"
    ],
    "optional_files": [
      "app/api/*/route.ts",
      "app/components/*.tsx"
    ]
  },
  "commands": {
    "install": "npm install",
    "install_legacy": "npm install --legacy-peer-deps",
    "build": "npm run build",
    "test": "npx jest --coverage",
    "prisma_migrate": "npx prisma migrate dev"
  },
  "testing": {
    "min_required_tests": 1,
    "allow_zero_tests_debug": false,
    "cleanup_stale_tests": "always"
  },
  "mandatory_rag_queries": [],
  "_NOTE_mandatory_rag_queries": "migré vers rules_dev.md — section Concepts Stack Obligatoires",
  "mandatory_rag_k": 3,
  "mandatory_rag_snippet_chars": 900,
  "qdrant_filter": {
    "collection": "factory_standards",
    "filter": {
      "must": [
        {
          "should": [
            {
              "key": "metadata.stack",
              "match": {
                "value": "nextjs-clerk-prisma"
              }
            },
            {
              "key": "metadata.stack",
              "match": {
                "value": "global"
              }
            }
          ]
        },
        {
          "key": "metadata.status",
          "match": {
            "value": "active"
          }
        },
        {
          "key": "metadata.agent_context",
          "match": {
            "value": "dev"
          }
        }
      ]
    }
  },
  "architect_qdrant_filter": {
    "_comment": "SUPPRIMÉ (19 Mars 2026, Pré-Sprint 4.6) — Zone 0 (agent_context=architect) a été supprimée. L'architect utilise désormais le qdrant_filter standard (agent_context=dev, Zone 1-14). Le Brief Normalizer remplace le rôle de Zone 0.",
    "collection": "factory_standards",
    "filter": {
      "must": []
    }
  },
  "env_validation": {
    "required_vars": [
      "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
      "CLERK_SECRET_KEY",
      "DATABASE_URL"
    ],
    "regex": {
      "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "^pk_(test|live)_",
      "CLERK_SECRET_KEY": "^sk_(test|live)_",
      "DATABASE_URL": "^postgresql://"
    }
  },
  "compatibility_matrix": {
    "ts-jest": {
      "required_major": 29,
      "reason": "ts-jest 29.x est la seule branche supportée avec Jest 29 + TypeScript 5.x; versions 27/28 ciblent TS 4.x (warning de non-support affiché si versions incompatibles)",
      "incompatible_with": {
        "jest": ">=30"
      }
    },
    "next": {
      "min_major": 14,
      "max_major": 14,
      "reason": "Pinné à Next 14 pour validation Sprint 0-3 (POLICY factory); Next 15 + Clerk V6 est fonctionnel mais non validé par la factory — à promouvoir en matrice expérimentale v2.0"
    },
    "jest": {
      "required_major": 29,
      "reason": "jest@30 incompatible avec ts-jest@29"
    }
  },
  "test_import_rules": {
    "app_router_api": "import { handler } from '../../app/api/{name}/route'",
    "middleware": "import middleware from '../../middleware'"
  },
  "supervision": {
    "batch_size": 3,
    "supervisor_timeout_ms": 30000
  }
}
