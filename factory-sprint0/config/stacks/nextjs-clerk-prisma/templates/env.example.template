# =============================================================================
# {project_name} — Variables d'environnement requises
# Copier ce fichier en .env.local et remplir les valeurs réelles
# =============================================================================

# -----------------------------------------------------------------------------
# CLERK — Authentification
# Dashboard : https://dashboard.clerk.com → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# URLs de navigation Clerk v6
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# BASE DE DONNÉES — PostgreSQL (ex: Neon)
# Neon Dashboard : https://console.neon.tech → Connection Details
#
# DATABASE_URL     : URL avec pooling (PgBouncer) → pour Prisma Client (runtime)
# DIRECT_DATABASE_URL : URL directe sans pooling  → pour prisma db push / migrate
#
# Sur Neon : activer "Connection pooling" pour DATABASE_URL,
#            utiliser l'URL "Direct connection" pour DIRECT_DATABASE_URL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@hostname/{project_name}?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@hostname-direct/{project_name}?sslmode=require
