{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StackConfig",
  "type": "object",
  "required": [
    "id",
    "stack_id",
    "framework",
    "status",
    "packages",
    "blueprint",
    "prompt_rules",
    "technology_categories",
    "commands",
    "import_remaps",
    "mandatory_rag_queries",
    "qdrant_filter"
  ],
  "properties": {
    "id": { "type": "string" },
    "stack_id": { "type": "string" },
    "framework": { "type": "string" },
    "status": { "enum": ["stable", "experimental", "deprecated"] },
    "packages": { "type": "object" },
    "commands": { "type": "object" },
    "import_remaps": { "type": "object" },
    "mandatory_rag_queries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "qdrant_filter": { "type": "object" },
    "sanitizers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prompt_rules": {
      "type": "object",
      "required": ["auth_rules", "ui_rules", "security_rules"],
      "properties": {
        "package_scripts": { "type": "object" },
        "auth_rules": { "type": "array", "items": { "type": "string" } },
        "ui_rules": { "type": "array", "items": { "type": "string" } },
        "orm_rules": { "type": "array", "items": { "type": "string" } },
        "security_rules": { "type": "array", "items": { "type": "string" } },
        "test_rules": { "type": "array", "items": { "type": "string" } },
        "qa_rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "templates_folder": { "type": "string" },
    "template_files": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "templated_files": {
      "type": "object",
      "description": "Fichiers gérés par templates (non modifiables par le LLM) : {dest: template_rel_path}",
      "additionalProperties": { "type": "string" }
    },
    "env_validation": {
      "type": "object",
      "description": "Validation des variables d'environnement générées",
      "properties": {
        "required_vars": { "type": "array", "items": { "type": "string" } },
        "regex": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "spec_validation": {
      "type": "object",
      "description": "Règles de validation de la spec générée par l'Architect",
      "properties": {
        "required_keywords": { "type": "array", "items": { "type": "string" } },
        "forbidden_keywords": { "type": "array", "items": { "type": "string" } },
        "required_sections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "compatibility_matrix": {
      "type": "object",
      "description": "Contraintes de compatibilité entre packages (ex: ts-jest@29 requis avec jest@29)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "required_major": { "type": "integer" },
          "min_major": { "type": "integer" },
          "max_major": { "type": "integer" },
          "reason": { "type": "string" },
          "incompatible_with": { "type": "object" }
        }
      }
    },
    "forbidden_auth_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Patterns interdits dans la spec et le code générés (auth custom)"
    },
    "technology_categories": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "blueprint": {
      "type": "object",
      "required": ["required_files"],
      "properties": {
        "required_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "optional_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "root_file": {
      "type": "string",
      "description": "Fichier racine qui identifie le répertoire projet (ex: package.json pour Node, pyproject.toml pour Python). Utilisé par _find_project_dir pour déduire le workdir du projet généré.",
      "examples": ["package.json", "pyproject.toml", "requirements.txt", "Cargo.toml"]
    },
    "content_guards": {
      "type": "array",
      "description": "Guards de contenu fichier config-driven — lus par _prebuild_gates(). Aucune logique framework dans dev.py (T008/T009).",
      "items": {
        "type": "object",
        "required": ["id", "trigger_contains", "message_lines"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "file_prefix": { "type": "string" },
          "file_extensions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "trigger_contains": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "requires_first_directive": {
            "type": ["string", "null"],
            "description": "Chaîne sémantique dont la présence en 1ère ligne non-vide annule le déclenchement (ex: 'use client'). null = pas de vérification."
          },
          "conflicts_with_directive": {
            "type": ["string", "null"],
            "description": "Chaîne sémantique dont la présence en 1ère ligne non-vide déclenche le guard quand trigger_contains est trouvé (ex: import server-only dans un fichier 'use client'). null = pas de vérification."
          },
          "mode": {
            "type": "string",
            "enum": ["block", "warn"],
            "description": "Mode du guard: block (bloquant) ou warn (journalise sans bloquer)."
          },
          "exclude_paths": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Préfixes de chemins à exclure de ce guard."
          },
          "exclude_when_contains": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Sous-chaînes dont la présence dans le contenu exclut ce guard."
          },
          "message_lines": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Lignes du message constructif. '{details}' est remplacé par la liste des fichiers en violation."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
