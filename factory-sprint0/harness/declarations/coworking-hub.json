      "/": {
        "description": "Page publique — aucun appel Clerk. Catalogue des espaces de coworking disponibles. Chaque espace affiche son nom, sa description, son type, sa capacité, son tarif horaire et son adresse.",
        "data_fetches": [
          {
            "service": "spaceService.getPublicAll()",
            "as": "spaces"
          }
        ],
        "interactive": false,
        "kpis": [],
        "filtered_lists": []
      },
      "/dashboard": {
        "description": "Tableau de bord pour les membres connectés. Affiche le chiffre d'affaires du mois en cours, le nombre de réservations en attente de confirmation, et le total des factures impayées.",
        "data_fetches": [
          {
            "service": "reservationService.getAllWithRelations(userId)",
            "as": "reservations"
          },
          {
            "service": "invoiceService.getAll(userId)",
            "as": "invoices"
          }
        ],
        "interactive": false,
        "kpis": [
          {
            "label": "Chiffre d'affaires du mois",
            "source": "invoices",
            "agg": "sum",
            "field": "amount",
            "filter_field": "issueDate",
            "filter_value": "current_month"
          },
          {
            "label": "Réservations en attente",
            "source": "reservations",
            "agg": "count",
            "field": "",
            "filter_field": "status",
            "filter_value": "requested"
          },
          {
            "label": "Total des factures impayées",
            "source": "invoices",
            "agg": "sum",
            "field": "amount",
            "filter_field": "status",
            "filter_value": "pending"
          }
        ],
        "filtered_lists": []
      }
    },
