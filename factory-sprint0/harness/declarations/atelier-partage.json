    "pages_detail": {
      "/": {
        "description": "Page publique — aucun appel Clerk. Catalogue des ateliers créatifs avec titre, description, durée, prix et domaines.",
        "data_fetches": [
          {
            "service": "workshopService.getPublicAll()",
            "as": "workshops"
          }
        ],
        "interactive": false,
        "kpis": [],
        "filtered_lists": []
      },
      "/dashboard": {
        "description": "Tableau de bord de l'animateur. Affiche les réservations en attente, confirmées à venir, et le total encaissé ce mois-ci.",
        "data_fetches": [
          {
            "service": "reservationService.getAllWithRelations(userId)",
            "as": "reservations"
          }
        ],
        "interactive": false,
        "kpis": [
          {
            "label": "Réservations en attente",
            "source": "reservations",
            "agg": "count",
            "field": "",
            "filter_field": "status",
            "filter_value": "pending"
          },
          {
            "label": "Réservations confirmées à venir",
            "source": "reservations",
            "agg": "count",
            "field": "",
            "filter_field": "status",
            "filter_value": "confirmed"
          },
          {
            "label": "Total encaissé ce mois-ci",
            "source": "reservations",
            "agg": "sum",
            "field": "slot.workshop.price",
            "filter_field": "status",
            "filter_value": "completed"
          }
        ],
        "filtered_lists": []
      },
      "/my-profile": {
        "description": "Espace personnel pour gérer ses réservations passées et à venir, et ses coordonnées.",
        "data_fetches": [
          {
            "service": "reservationService.getAllWithRelations(userId)",
            "as": "userReservations"
          }
        ],
        "interactive": true,
        "kpis": [],
        "filtered_lists": [
          {
            "label": "Réservations à venir",
            "source": "userReservations",
            "filter_field": "slot.startTime",
            "filter_op": "after",
            "filter_value": "now"
          },
          {
            "label": "Réservations passées",
            "source": "userReservations",
            "filter_field": "slot.startTime",
            "filter_op": "before",
            "filter_value": "now"
          }
        ]
      }
    },
