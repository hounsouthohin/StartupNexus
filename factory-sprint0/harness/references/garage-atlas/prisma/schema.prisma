generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RepairStatus {
  pending
  accepted
  rejected
  in_progress
  completed
}

model Client {
  id String @id @default(uuid())
  name String
  phone String
  vehicles Vehicle[]
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Vehicle {
  id String @id @default(uuid())
  brand String
  model String
  licensePlate String
  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  repairs Repair[]
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Repair {
  id String @id @default(uuid())
  description String
  status RepairStatus @default(pending)
  reasonForRejection String?
  amountCharged Float?
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
