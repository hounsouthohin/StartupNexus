generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TuitionFee {
  id String @id @default(uuid())
  amount Float
  dueDate DateTime
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model StudentRecord {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courses Course[]
  internships Internship[]
  foreignExchanges ForeignExchange[]
  projects Project[]
  continuousAssessments ContinuousAssessment[]
  exams Exam[]
  defenses Defense[]
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Course {
  id String @id @default(uuid())
  name String
  description String?
  credits Int
  coefficient Float
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  continuousAssessments ContinuousAssessment[]
  grades Grade[]
  studentRecords StudentRecord[]
  @@index([userId])
}

model Internship {
  id String @id @default(uuid())
  companyName String
  duration Int
  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studentRecords StudentRecord[]
  @@index([userId])
}

