'use client'

{% if has_delete or has_search %}
import { useState } from 'react'
{% endif %}
import Link from 'next/link'
import type { {{ serialized_type }} } from '@/lib/types'
{% if date_fields %}
import { formatDate } from '@/lib/utils'
{% endif %}
{% if entity_icon %}
import { {{ entity_icon }} } from 'lucide-react'
{% endif %}
{% if has_delete %}
import { delete{{ name }} } from '@/app/{{ list_dir }}/actions'
{% endif %}
{% if status_field and status_labels %}

const STATUS_LABELS: Record<string, string> = {
{% for val, label in status_labels.items() %}
  {{ val }}: '{{ label }}',
{% endfor %}
}
{% endif %}

interface {{ client_name }}Props {
  items: {{ serialized_type }}[]
}

export default function {{ client_name }}({ items }: {{ client_name }}Props) {
  {% if has_delete %}
  const [list, setList] = useState(items)
  {% else %}
  const list = items
  {% endif %}
  {% if has_search %}
  const [query, setQuery] = useState('')
  const filtered = query
    ? list.filter(item =>
        [{% for field in display_fields %}'{{ field }}'{% if not loop.last %}, {% endif %}{% endfor %}]
          .some(k => String((item as Record<string, unknown>)[k] ?? '').toLowerCase().includes(query.toLowerCase()))
      )
    : list
  {% else %}
  const filtered = list
  {% endif %}

  {% if has_delete %}
  const handleDelete = async (id: string) => {
    if (!confirm('Supprimer cet élément ?')) return
    const result = await delete{{ name }}(id)
    if (result?.error) { alert(result.error); return }
    setList(prev => prev.filter(item => item.id !== id))
  }
  {% endif %}

  return (
    <main className="container mx-auto {{ p_cls }}">
      <div className="flex items-center justify-between mb-6">
        <h1 className="text-2xl font-bold text-foreground">{% if entity_icon %}<{{ entity_icon }} className="w-5 h-5 text-primary inline-block mr-2" />{% endif %}{{ title_plural }}</h1>
        {% if auth_required %}
        <Link
          href="{{ list_path }}/new"
          className="px-4 py-2 bg-{{ primary }} text-white rounded-md hover:bg-{{ primary_hover }} text-sm font-medium"
        >
          Nouveau
        </Link>
        {% endif %}
      </div>

      {% if has_search %}
      <div className="mb-4">
        <input
          type="search"
          placeholder="Rechercher…"
          value={query}
          onChange={e => setQuery(e.target.value)}
          className="w-full max-w-sm px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }}"
        />
      </div>

      {% endif %}
      {filtered.length === 0 ? (
        <div className="text-center py-12 text-muted-foreground">
          {% if has_search %}
          <p className="text-lg">{query ? 'Aucun résultat pour cette recherche.' : "{{ empty_state_message if empty_state_message else 'Aucun ' + camel + ' pour le moment.' }}"}</p>
          {% else %}
          <p className="text-lg">{{ empty_state_message if empty_state_message else "Aucun " + camel + " pour le moment." }}</p>
          {% endif %}
          {% if auth_required %}
          <Link href="{{ list_path }}/new" className="mt-4 inline-block text-{{ primary }} hover:underline text-sm">
            Créer le premier
          </Link>
          {% endif %}
        </div>
      ) : (
        <div className="overflow-hidden {{ card_cls }}">
          <table className="min-w-full divide-y divide-border">
            <thead className="bg-muted">
              <tr>
                {% for field in display_fields %}
                <th className="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">
                  {{ field_labels.get(field, field) }}
                </th>
                {% endfor %}
                {% for rel in parent_relations %}
                <th className="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">
                  {{ rel.label }}
                </th>
                {% endfor %}
                {% if auth_required %}
                <th className="px-6 py-3 text-right text-xs font-medium text-muted-foreground uppercase tracking-wider">
                  Actions
                </th>
                {% endif %}
              </tr>
            </thead>
            <tbody className="bg-card divide-y divide-border">
              {filtered.map(item => (
                <tr key={item.id} className="hover:bg-muted/50 {{ transition_cls }}">
                  {% for field in display_fields %}
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-foreground">
                    {% if status_field and status_labels and field == status_field %}
                    <span className="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-muted text-foreground">
                      {STATUS_LABELS[item.{{ field }}] ?? String(item.{{ field }} ?? '')}
                    </span>
                    {% elif field in boolean_fields %}
                    <span className={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${item.{{ field }} ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}`}>
                      {item.{{ field }} ? '{{ "Publié" if field == "published" else "Oui" }}' : '{{ "Brouillon" if field == "published" else "Non" }}'}
                    </span>
                    {% elif field in date_fields %}
                    {formatDate(item.{{ field }})}
                    {% else %}
                    {String(item.{{ field }} ?? '')}
                    {% endif %}
                  </td>
                  {% endfor %}
                  {% for rel in parent_relations %}
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground">
                    {String((item as any).{{ rel.related_camel }}?.{{ rel.display_field }} ?? '—')}
                  </td>
                  {% endfor %}
                  {% if auth_required %}
                  <td className="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <div className="flex justify-end gap-2">
                      {% if has_detail %}
                      <Link
                        href={`{{ list_path }}/{{ '${' }}{% if has_slug %}item.slug{% else %}item.id{% endif %}}`}
                        className="px-3 py-1 text-xs font-medium text-muted-foreground border border-border rounded hover:bg-muted/50"
                      >
                        Voir
                      </Link>
                      {% endif %}
                      <Link
                        href={`{{ list_path }}/{{ '${' }}{% if has_slug %}item.slug{% else %}item.id{% endif %}}/edit`}
                        className="px-3 py-1 text-xs font-medium text-{{ primary }} border border-{{ primary }} rounded hover:bg-{{ primary_light }}"
                      >
                        Modifier
                      </Link>
                      {% if has_delete %}
                      <button
                        onClick={() => handleDelete(item.id)}
                        className="px-3 py-1 text-xs font-medium text-red-600 border border-red-600 rounded hover:bg-red-50"
                      >
                        Supprimer
                      </button>
                      {% endif %}
                    </div>
                  </td>
                  {% endif %}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </main>
  )
}
