'use client'

import { useActionState } from 'react'
import Link from 'next/link'
import type { {{ serialized_type }} } from '@/lib/types'
{% for fk in fk_fields %}
import type { Serialized{{ fk.related_model }} } from '@/lib/types'
{% endfor %}
{% for mf in m2m_fields if mf.needs_prop %}
import type { Serialized{{ mf.related_model }} } from '@/lib/types'
{% endfor %}
import { update{{ name }} } from '@/app/{{ list_dir }}/actions'

{% if flow_locked %}
// Verrou d'édition (type I) : dans ces états les champs métier sont figés. Le changement
// d'état lui-même se fait via les boutons de transition de la page détail, pas ici.
const FLOW_LOCKED: string[] = {{ flow_locked_json }}
{% endif %}

interface {{ client_name }}Props {
  item: {{ serialized_type }}
  {% for fk in fk_fields %}
  {{ fk.related_camel }}Options: Serialized{{ fk.related_model }}[]
  {% endfor %}
  {% for mf in m2m_fields if mf.needs_prop %}
  {{ mf.related_camel }}Options: Serialized{{ mf.related_model }}[]
  {% endfor %}
}

export default function {{ client_name }}({ item{% for fk in fk_fields %}, {{ fk.related_camel }}Options{% endfor %}{% for mf in m2m_fields if mf.needs_prop %}, {{ mf.related_camel }}Options{% endfor %} }: {{ client_name }}Props) {
  const [error, formAction, isPending] = useActionState(
    async (_prev: unknown, formData: FormData) => {
      try { await update{{ name }}.bind(null, item.id)(formData); return null }
      catch (e) { return (e as Error).message }
    },
    null,
  )
{% if flow_locked %}
  const _isLocked = FLOW_LOCKED.includes(item.{{ flow_field }})
{% endif %}

  return (
    <main className="container mx-auto {{ p_cls }} max-w-xl">
      <div className="flex items-center gap-3 mb-6">
        <Link href="{{ list_path }}" className="text-muted-foreground hover:text-foreground">←</Link>
        <h1 className="text-2xl font-bold text-foreground">Modifier {{ title_singular }}</h1>
      </div>

      {error && <p className="mb-4 text-sm text-red-600 bg-red-50 px-4 py-2 rounded">{error}</p>}
{% if flow_locked %}
      {_isLocked && (
        <p className="mb-4 text-sm text-amber-800 bg-amber-50 border border-amber-200 px-4 py-2 rounded">
          Les informations ne sont plus modifiables à ce stade. Vous pouvez encore faire évoluer l&apos;état.
        </p>
      )}
{% endif %}

      <form action={formAction} className="space-y-4 {{ card_cls }} {{ p_cls }}">
        {% for field in editable_fields %}
        <div>
          <label htmlFor="{{ field.name }}" className="block text-sm font-medium text-foreground mb-1">
            {{ field_labels.get(field.name, field.name) }}
          </label>
          {% if field.input_type == 'textarea' %}
          <textarea
            id="{{ field.name }}"
            name="{{ field.name }}"
            rows={{ '{' }}{{ 12 if field.name in ('content', 'body', 'instructions') else 4 }}}
            defaultValue={item.{{ field.name }} ?? ''}
            {% if flow_locked %}disabled={_isLocked}{% endif %}
            className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }} disabled:bg-muted disabled:text-muted-foreground"
          />
          {% elif field.input_type == 'checkbox' %}
          <input
            type="checkbox"
            id="{{ field.name }}"
            name="{{ field.name }}"
            value="true"
            defaultChecked={Boolean(item.{{ field.name }})}
            {% if flow_locked %}disabled={_isLocked}{% endif %}
            className="h-4 w-4 text-{{ primary }} border-border rounded disabled:opacity-50"
          />
          {% elif field.input_type == 'enum-select' %}
          <select
            id="{{ field.name }}"
            name="{{ field.name }}"
            defaultValue={item.{{ field.name }} ?? ''}
            {% if flow_locked %}disabled={_isLocked}{% endif %}
            className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }} disabled:bg-muted disabled:text-muted-foreground"
          >
            <option value="">Sélectionner…</option>
            {% for val in field.enum_values %}
            <option value="{{ val }}">{{ field.enum_labels.get(val, val) }}</option>
            {% endfor %}
          </select>
          {% elif field.input_type == 'date' %}
          <input
            type="date"
            id="{{ field.name }}"
            name="{{ field.name }}"
            defaultValue={item.{{ field.name }} ? (item.{{ field.name }} as string).slice(0, 10) : ''}
            {% if flow_locked %}disabled={_isLocked}{% endif %}
            className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }} disabled:bg-muted disabled:text-muted-foreground"
          />
          {% elif field.input_type == 'datetime-local' %}
          <input
            type="datetime-local"
            id="{{ field.name }}"
            name="{{ field.name }}"
            defaultValue={item.{{ field.name }} ? new Date(item.{{ field.name }} as string).toISOString().slice(0, 16) : ''}
            {% if flow_locked %}disabled={_isLocked}{% endif %}
            className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }} disabled:bg-muted disabled:text-muted-foreground"
          />
          {% else %}
          <input
            type="{{ field.input_type }}"
            id="{{ field.name }}"
            name="{{ field.name }}"
            defaultValue={item.{{ field.name }} != null ? String(item.{{ field.name }}) : ''}
            {% if field.input_type == 'number' %}step="any" {% endif %}
            {% if flow_locked %}disabled={_isLocked} {% endif %}
            className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }} disabled:bg-muted disabled:text-muted-foreground"
          />
          {% endif %}
        </div>
        {% endfor %}

        {% for fk in fk_fields %}
        <div>
          <label htmlFor="{{ fk.field_name }}" className="block text-sm font-medium text-foreground mb-1">
            {{ field_labels.get(fk.field_name, fk.related_model) }}
          </label>
          <select
            id="{{ fk.field_name }}"
            name="{{ fk.field_name }}"
            defaultValue={item.{{ fk.field_name }} ?? ''}
            {% if flow_locked %}disabled={_isLocked}{% endif %}
            className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }} disabled:bg-muted disabled:text-muted-foreground"
          >
            <option value="">Sélectionner…</option>
            {{ '{' }}{{ fk.related_camel }}Options.map(opt => (
              <option key={opt.id} value={opt.id}>{String(opt.{{ fk.related_display }} ?? opt.id)}</option>
            ))}
          </select>
        </div>
        {% endfor %}

        {% for mf in m2m_fields %}
        <div>
          <span className="block text-sm font-medium text-foreground mb-1">{{ mf.label }}</span>
          <div className="max-h-40 overflow-y-auto border border-border rounded-md p-3 space-y-2">
            {{ '{' }}{{ mf.related_camel }}Options.length === 0 ? (
              <p className="text-sm text-muted-foreground">Aucun élément disponible.</p>
            ) : {{ mf.related_camel }}Options.map(opt => (
              <label key={opt.id} className="flex items-center gap-2 text-sm text-foreground">
                <input
                  type="checkbox"
                  name="{{ mf.input_name }}"
                  value={opt.id}
                  defaultChecked={(item.{{ mf.name }} ?? []).some(rel => rel.id === opt.id)}
                  className="h-4 w-4 text-{{ primary }} border-border rounded"
                />
                <span>{String(opt.{{ mf.related_display }} ?? opt.id)}</span>
              </label>
            ))}
          </div>
        </div>
        {% endfor %}

        <div className="flex gap-3 pt-2">
          <button
            type="submit"
            disabled={isPending}
            className="flex-1 px-6 py-2 bg-{{ primary }} text-white rounded-md text-sm font-medium hover:bg-{{ primary_hover }} disabled:opacity-50"
          >
            {isPending ? 'En cours…' : 'Enregistrer'}
          </button>
          <Link
            href="{{ list_path }}"
            className="px-6 py-2 border border-border rounded-md text-sm font-medium text-foreground hover:bg-muted/50"
          >
            Annuler
          </Link>
        </div>
      </form>
    </main>
  )
}
