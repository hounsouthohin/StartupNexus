'use client'

import Link from 'next/link'
import type { {{ serialized_type }} } from '@/lib/types'
{% if has_delete %}
import { delete{{ name }} } from '@/app/{{ list_dir }}/actions'
{% endif %}
{% if value_labels %}

const FIELD_VALUE_LABELS: Record<string, Record<string, string>> = {{ value_labels | tojson }};
{% endif %}

interface {{ client_name }}Props {
  item: {{ serialized_type }}
}

export default function {{ client_name }}({ item }: {{ client_name }}Props) {
  {% if has_delete %}
  const handleDelete = async () => {
    if (!confirm('Supprimer cet élément ?')) return
    await delete{{ name }}(item.id)
  }
  {% endif %}

  return (
    <main className="container mx-auto p-6 max-w-2xl">
      <div className="flex items-center gap-3 mb-6">
        <Link href="{{ list_path }}" className="text-gray-400 hover:text-gray-600">←</Link>
        <h1 className="text-2xl font-bold text-gray-900">{{ name }}</h1>
      </div>

      <div className="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <dl className="divide-y divide-gray-100">
          {% for field in display_fields %}
          <div className="px-6 py-4 grid grid-cols-3 gap-4">
            <dt className="text-sm font-medium text-gray-500">{{ field_labels.get(field, field) }}</dt>
            <dd className="text-sm text-gray-900 col-span-2">
              {% if value_labels and field in value_labels %}
              {(FIELD_VALUE_LABELS['{{ field }}'] ?? {})[String(item.{{ field }})] ?? String(item.{{ field }} ?? '—')}
              {% else %}
              {String(item.{{ field }} ?? '—')}
              {% endif %}
            </dd>
          </div>
          {% endfor %}
        </dl>
      </div>

      <div className="mt-6 flex gap-3">
        {% if auth_required %}
        <Link
          href={`{{ list_path }}/${item.id}/edit`}
          className="px-4 py-2 bg-{{ primary }} text-white rounded-md hover:bg-{{ primary_hover }} text-sm font-medium"
        >
          Modifier
        </Link>
        {% if has_delete %}
        <button
          onClick={handleDelete}
          className="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 text-sm font-medium"
        >
          Supprimer
        </button>
        {% endif %}
        {% endif %}
        <Link
          href="{{ list_path }}"
          className="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50"
        >
          Retour
        </Link>
      </div>
    </main>
  )
}
