'use client'

import Link from 'next/link'
import type { {{ serialized_type }} } from '@/lib/types'
{% if date_fields %}
import { formatDate } from '@/lib/utils'
{% endif %}
{% if currency_fields %}
import { formatCurrency } from '@/lib/utils'
{% endif %}
{% if entity_icon %}
import { {{ entity_icon }} } from 'lucide-react'
{% endif %}
{% if has_delete %}
import { delete{{ name }} } from '@/app/{{ list_dir }}/actions'
{% endif %}
{% if flow_field %}
import { transition{{ name }} } from '@/app/{{ list_dir }}/actions'
{% endif %}
{% if value_labels %}

const FIELD_VALUE_LABELS: Record<string, Record<string, string>> = {{ value_labels | tojson }};
{% endif %}
{% if flow_field %}
// Machine à états (type I) : transitions permises + champs captés à la transition.
const FLOW_TRANSITIONS: Record<string, string[]> = {{ flow_transitions_json }}
const FLOW_LABELS: Record<string, string> = {{ flow_labels_json }}
const FLOW_STATE_FIELDS: Record<string, string[]> = {{ flow_state_fields_json }}
const FLOW_FIELD_LABELS: Record<string, string> = {{ flow_field_labels_json }}
{% endif %}

interface {{ client_name }}Props {
  item: {{ serialized_type }}
}

export default function {{ client_name }}({ item }: {{ client_name }}Props) {
  {% if has_delete %}
  const handleDelete = async () => {
    if (!confirm('Supprimer cet élément ?')) return
    await delete{{ name }}(item.id)
  }
  {% endif %}

  return (
    <main className="container mx-auto {{ p_cls }} max-w-2xl">
      <div className="flex items-center gap-3 mb-6">
        <Link href="{{ list_path }}" className="text-muted-foreground hover:text-foreground">←</Link>
        {% if title_field %}
        <h1 className="text-2xl font-bold text-foreground">{% if entity_icon %}<{{ entity_icon }} className="w-5 h-5 text-primary inline-block mr-2" />{% endif %}{String(item.{{ title_field }} ?? '{{ title_singular }}')}</h1>
        {% else %}
        <h1 className="text-2xl font-bold text-foreground">{% if entity_icon %}<{{ entity_icon }} className="w-5 h-5 text-primary inline-block mr-2" />{% endif %}{{ title_singular }}</h1>
        {% endif %}
      </div>
      {% for mf in m2m_display %}

      {(item.{{ mf.name }} ?? []).length > 0 && (
        <div className="flex flex-wrap gap-2 mb-4">
          {(item.{{ mf.name }} ?? []).map(rel => (
            <span key={rel.id} className="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-{{ primary_light }} text-{{ primary }}">
              {String(rel.{{ mf.display_field }} ?? '')}
            </span>
          ))}
        </div>
      )}
      {% endfor %}

      {% if not auth_required and textarea_fields %}
      {# Pages publiques : champs textarea rendus en prose pleine largeur avant la fiche #}
      {% for field in display_fields %}
      {% if field in textarea_fields %}
      <div className="{{ card_cls }} p-6 mb-4">
        <p className="text-sm font-medium text-muted-foreground mb-2">{{ field_labels.get(field, field) }}</p>
        <p className="text-foreground leading-relaxed whitespace-pre-wrap">{String(item.{{ field }} ?? '')}</p>
      </div>
      {% endif %}
      {% endfor %}
      {% endif %}

      {% set dl_fields = [] %}
      {% for field in display_fields %}
        {% if not (not auth_required and textarea_fields and field in textarea_fields) and not (not auth_required and title_field and field == title_field) %}
          {% set _ = dl_fields.append(field) %}
        {% endif %}
      {% endfor %}
      {% if dl_fields %}
      <div className="{{ card_cls }} overflow-hidden">
        <dl className="divide-y divide-border">
          {% for field in dl_fields %}
          <div className="px-6 py-4 grid grid-cols-3 gap-4">
            <dt className="text-sm font-medium text-muted-foreground">{{ field_labels.get(field, field) }}</dt>
            <dd className="text-sm text-foreground col-span-2">
              {% if field in boolean_fields %}
              <span className={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${item.{{ field }} ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}`}>
                {item.{{ field }} ? '{{ "Publié" if field == "published" else "Oui" }}' : '{{ "Brouillon" if field == "published" else "Non" }}'}
              </span>
              {% elif field in badge_map %}
              {{ '{' }}{% for value, meta in badge_map[field].items() %}item.{{ field }} === '{{ value }}' ? <span className="inline-flex px-2 py-0.5 rounded-full text-xs font-medium {{ meta.cls }}">{{ meta.label }}</span> : {% endfor %}<span className="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{String(item.{{ field }} ?? '—')}</span>{{ '}' }}
              {% elif field in date_fields %}
              {formatDate(item.{{ field }})}
              {% elif field in currency_fields %}
              {formatCurrency(item.{{ field }})}
              {% elif value_labels and field in value_labels %}
              {(FIELD_VALUE_LABELS['{{ field }}'] ?? {})[String(item.{{ field }})] ?? String(item.{{ field }} ?? '—')}
              {% else %}
              {String(item.{{ field }} ?? '—')}
              {% endif %}
            </dd>
          </div>
          {% endfor %}
        </dl>
      </div>
      {% endif %}

      {% if flow_field %}
      {(FLOW_TRANSITIONS[item.{{ flow_field }}] ?? []).length > 0 && (
        <div className="mt-6 {{ card_cls }} p-6">
          <p className="text-sm font-medium text-foreground mb-3">Faire évoluer l&apos;état</p>
          <div className="space-y-3">
            {(FLOW_TRANSITIONS[item.{{ flow_field }}] ?? []).map(_target => (
              <form key={_target} action={transition{{ name }}.bind(null, item.id, _target)} className="flex items-end gap-3">
                {(FLOW_STATE_FIELDS[_target] ?? []).map(_f => (
                  <div key={_f} className="flex-1">
                    <label htmlFor={_f} className="block text-xs font-medium text-muted-foreground mb-1">{FLOW_FIELD_LABELS[_f] ?? _f}</label>
                    <textarea id={_f} name={_f} required rows={2} className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }}" />
                  </div>
                ))}
                <button type="submit" className="px-4 py-2 bg-{{ primary }} text-white rounded-md hover:bg-{{ primary_hover }} text-sm font-medium whitespace-nowrap">
                  {FLOW_LABELS[_target] ?? _target}
                </button>
              </form>
            ))}
          </div>
        </div>
      )}
      {% endif %}

      <div className="mt-6 flex gap-3">
        {% if auth_required %}
        <Link
          href={`{{ list_path }}/${item.id}/edit`}
          className="px-4 py-2 bg-{{ primary }} text-white rounded-md hover:bg-{{ primary_hover }} text-sm font-medium"
        >
          Modifier
        </Link>
        {% if has_delete %}
        <button
          onClick={handleDelete}
          className="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 text-sm font-medium"
        >
          Supprimer
        </button>
        {% endif %}
        {% endif %}
        <Link
          href="{{ list_path }}"
          className="px-4 py-2 border border-border rounded-md text-sm font-medium text-foreground hover:bg-muted/50"
        >
          Retour
        </Link>
      </div>
    </main>
  )
}
