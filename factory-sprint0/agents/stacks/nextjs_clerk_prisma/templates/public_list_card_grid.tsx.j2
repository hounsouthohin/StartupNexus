'use client'

import Link from 'next/link'
import type { {{ serialized_type }} } from '@/lib/types'
{% if date_fields %}
import { formatDate } from '@/lib/utils'
{% endif %}
{% if currency_fields %}
import { formatCurrency } from '@/lib/utils'
{% endif %}
{% if entity_icon %}
import { {{ entity_icon }} } from 'lucide-react'
{% endif %}

interface {{ client_name }}Props {
  items: {{ serialized_type }}[]
}

export default function {{ client_name }}({ items }: {{ client_name }}Props) {
  return (
    <main className="container mx-auto {{ p_cls }}">
      <h1 className="text-3xl font-bold text-foreground mb-8">{% if entity_icon %}<{{ entity_icon }} className="w-6 h-6 text-primary inline-block mr-2" />{% endif %}{{ title_plural }}</h1>

      {items.length === 0 ? (
        <div className="text-center py-16 text-muted-foreground">
          <p className="text-lg">{{ empty_state_message if empty_state_message else "Aucun " + camel + " pour le moment." }}</p>
        </div>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map(item => (
            <div
              key={item.id}
              className="{{ card_cls }} overflow-hidden {{ transition_cls }} hover:shadow-md group"
            >
              <div className="p-5">
                {% if display_fields %}
                {% set primary_field = display_fields[0] %}
                <h2 className="text-lg font-semibold text-foreground group-hover:text-{{ primary }} {{ transition_cls }} mb-2 line-clamp-2">
                  {String(item.{{ primary_field }} ?? '—')}
                </h2>
                {% for field in display_fields[1:3] %}
                <p className="text-sm text-muted-foreground mb-1 line-clamp-3">
                  {% if field in date_fields %}{formatDate(item.{{ field }})}{% elif field in currency_fields %}{formatCurrency(item.{{ field }})}{% else %}{String(item.{{ field }} ?? '—')}{% endif %}
                </p>
                {% endfor %}
                {% if parent_relations %}
                <p className="text-xs text-muted-foreground mt-2">
                  {% for rel in parent_relations %}{String((item as any).{{ rel.related_camel }}?.{{ rel.display_field }} ?? '')}{% endfor %}
                </p>
                {% endif %}
                {% endif %}
              </div>
              {% if has_detail %}
              <div className="px-5 pb-5">
                <Link
                  href={`{{ list_path }}/{{ '${' }}{% if has_slug %}item.slug{% else %}item.id{% endif %}}`}
                  className="inline-flex items-center text-sm font-medium text-{{ primary }} hover:underline {{ transition_cls }}"
                >
                  Lire →
                </Link>
              </div>
              {% endif %}
            </div>
          ))}
        </div>
      )}
    </main>
  )
}
