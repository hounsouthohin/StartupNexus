'use client'

import { useState } from 'react'
import Link from 'next/link'
import type { {{ serialized_type }} } from '@/lib/types'
{% if has_delete %}
import { delete{{ name }} } from '@/app/{{ list_dir }}/actions'
{% endif %}

interface {{ client_name }}Props {
  items: {{ serialized_type }}[]
}

export default function {{ client_name }}({ items }: {{ client_name }}Props) {
  const [list, setList] = useState(items)
  const [query, setQuery] = useState('')

  const filtered = query
    ? list.filter(item =>
        [{% for field in display_fields %}'{{ field }}'{% if not loop.last %}, {% endif %}{% endfor %}]
          .some(k => String((item as Record<string, unknown>)[k] ?? '').toLowerCase().includes(query.toLowerCase()))
      )
    : list

  {% if has_delete %}
  const handleDelete = async (id: string) => {
    if (!confirm('Supprimer cet élément ?')) return
    await delete{{ name }}(id)
    setList(prev => prev.filter(item => item.id !== id))
  }
  {% endif %}

  return (
    <main className="container mx-auto p-6">
      <div className="flex items-center justify-between mb-4">
        <h1 className="text-2xl font-bold text-foreground">{{ title_plural }}</h1>
        {% if auth_required %}
        <Link href="{{ list_path }}/new" className="px-4 py-2 bg-{{ primary }} text-white rounded-md hover:bg-{{ primary_hover }} text-sm font-medium">
          Nouveau
        </Link>
        {% endif %}
      </div>

      <div className="mb-4">
        <input
          type="search"
          placeholder="Rechercher…"
          value={query}
          onChange={e => setQuery(e.target.value)}
          className="w-full max-w-sm px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }}"
        />
      </div>

      {filtered.length === 0 ? (
        <div className="text-center py-12 text-muted-foreground">
          <p>{query ? 'Aucun résultat pour cette recherche.' : "{{ empty_state_message if empty_state_message else 'Aucun élément.' }}"}</p>
        </div>
      ) : (
        <div className="overflow-hidden shadow-sm border border-border rounded-lg">
          <table className="min-w-full divide-y divide-border">
            <thead className="bg-muted">
              <tr>
                {% for field in display_fields %}
                <th className="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">{{ field_labels.get(field, field) }}</th>
                {% endfor %}
                {% if auth_required %}
                <th className="px-6 py-3 text-right text-xs font-medium text-muted-foreground uppercase tracking-wider">Actions</th>
                {% endif %}
              </tr>
            </thead>
            <tbody className="bg-card divide-y divide-border">
              {filtered.map(item => (
                <tr key={item.id} className="hover:bg-muted/50">
                  {% for field in display_fields %}
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-foreground">{String(item.{{ field }} ?? '')}</td>
                  {% endfor %}
                  {% if auth_required %}
                  <td className="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <div className="flex justify-end gap-2">
                      <Link href={`{{ list_path }}/${{% if has_slug %}item.slug{% else %}item.id{% endif %}}/edit`} className="px-3 py-1 text-xs font-medium text-{{ primary }} border border-{{ primary }} rounded hover:bg-{{ primary_light }}">
                        Modifier
                      </Link>
                      {% if has_delete %}
                      <button onClick={() => handleDelete(item.id)} className="px-3 py-1 text-xs font-medium text-red-600 border border-red-600 rounded hover:bg-red-50">
                        Supprimer
                      </button>
                      {% endif %}
                    </div>
                  </td>
                  {% endif %}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </main>
  )
}
