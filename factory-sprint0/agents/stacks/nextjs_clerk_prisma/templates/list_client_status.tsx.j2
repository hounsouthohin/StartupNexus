'use client'

import { useState } from 'react'
import Link from 'next/link'
import type { {{ serialized_type }} } from '@/lib/types'
{% if has_delete %}
import { delete{{ name }} } from '@/app/{{ list_dir }}/actions'
{% endif %}

{% set _COLOR_HINTS = {
  'pending':    'bg-yellow-100 text-yellow-800',
  'waiting':    'bg-yellow-100 text-yellow-800',
  'review':     'bg-blue-100  text-blue-800',
  'in_progress':'bg-blue-100  text-blue-800',
  'active':     'bg-green-100 text-green-800',
  'approved':   'bg-green-100 text-green-800',
  'published':  'bg-green-100 text-green-800',
  'done':       'bg-green-100 text-green-800',
  'completed':  'bg-green-100 text-green-800',
  'rejected':   'bg-red-100   text-red-800',
  'cancelled':  'bg-red-100   text-red-800',
  'failed':     'bg-red-100   text-red-800',
  'draft':      'bg-muted  text-muted-foreground',
  'archived':   'bg-muted  text-muted-foreground',
  'inactive':   'bg-muted  text-muted-foreground',
} %}
const STATUS_COLORS: Record<string, string> = {
{% for val in status_values %}
  {{ val }}: '{{ _COLOR_HINTS.get(val, 'bg-muted text-muted-foreground') }}',
{% endfor %}
}

const statusColor = (s: string) =>
  STATUS_COLORS[s?.toLowerCase()] ?? 'bg-muted text-muted-foreground'

interface {{ client_name }}Props {
  items: {{ serialized_type }}[]
}

export default function {{ client_name }}({ items }: {{ client_name }}Props) {
  const [list, setList] = useState(items)
  {% if has_search %}
  const [query, setQuery] = useState('')
  {% endif %}
  const [statusFilter, setStatusFilter] = useState('')

  const filtered = list
    .filter(item => !statusFilter || (item as Record<string, unknown>).{{ status_field }} === statusFilter)
    {% if has_search %}
    .filter(item => !query || [{% for field in display_fields %}'{{ field }}'{% if not loop.last %}, {% endif %}{% endfor %}]
      .some(k => String((item as Record<string, unknown>)[k] ?? '').toLowerCase().includes(query.toLowerCase())))
    {% endif %}

  {% if has_delete %}
  const handleDelete = async (id: string) => {
    if (!confirm('Supprimer cet élément ?')) return
    const result = await delete{{ name }}(id)
    if (result?.error) { alert(result.error); return }
    setList(prev => prev.filter(item => item.id !== id))
  }
  {% endif %}

  return (
    <main className="container mx-auto {{ p_cls }}">
      <div className="flex items-center justify-between mb-4">
        <h1 className="text-2xl font-bold text-foreground">{{ title_plural }}</h1>
        {% if auth_required %}
        <Link href="{{ list_path }}/new" className="px-4 py-2 bg-{{ primary }} text-white rounded-md hover:bg-{{ primary_hover }} text-sm font-medium">
          Nouveau
        </Link>
        {% endif %}
      </div>

      <div className="flex flex-wrap gap-3 mb-4">
        {% if has_search %}
        <input
          type="search"
          placeholder="Rechercher…"
          {% if has_search %}value={query} onChange={e => setQuery(e.target.value)}{% endif %}
          className="px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }} w-full max-w-xs"
        />
        {% endif %}
        <select
          value={statusFilter}
          onChange={e => setStatusFilter(e.target.value)}
          className="px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }}"
        >
          <option value="">Tous les statuts</option>
          {% for val in status_values %}
          <option value="{{ val }}">{{ status_labels.get(val, val) }}</option>
          {% endfor %}
        </select>
      </div>

      {filtered.length === 0 ? (
        <div className="text-center py-12 text-muted-foreground">
          <p>{list.length === 0 ? "{{ empty_state_message if empty_state_message else 'Aucun ' + camel + ' pour le moment.' }}" : 'Aucun résultat pour ce filtre.'}</p>
        </div>
      ) : (
        <div className="overflow-hidden shadow-sm border border-border rounded-lg">
          <table className="min-w-full divide-y divide-border">
            <thead className="bg-muted">
              <tr>
                {% for field in display_fields %}
<th className="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">{{ field_labels.get(field, field) }}</th>
                {% endfor %}
                <th className="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Statut</th>
                {% if auth_required %}
                <th className="px-6 py-3 text-right text-xs font-medium text-muted-foreground uppercase tracking-wider">Actions</th>
                {% endif %}
              </tr>
            </thead>
            <tbody className="bg-card divide-y divide-border">
              {filtered.map(item => (
                <tr key={item.id} className="hover:bg-muted/50">
                  {% for field in display_fields %}
                  <td className="px-6 py-4 whitespace-nowrap text-sm text-foreground">{String(item.{{ field }} ?? '')}</td>
                  {% endfor %}
                  <td className="px-6 py-4 whitespace-nowrap">
                    <span className={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${statusColor(String((item as Record<string, unknown>).{{ status_field }} ?? ''))}`}>
                      {String((item as Record<string, unknown>).{{ status_field }} ?? '—')}
                    </span>
                  </td>
                  {% if auth_required %}
                  <td className="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <div className="flex justify-end gap-2">
{% if has_slug %}
                      <Link href={`{{ list_path }}/${item.slug}/edit`} className="px-3 py-1 text-xs font-medium text-{{ primary }} border border-{{ primary }} rounded hover:bg-{{ primary_light }}">
                        Modifier
                      </Link>
{% else %}
                      <Link href={`{{ list_path }}/${item.id}/edit`} className="px-3 py-1 text-xs font-medium text-{{ primary }} border border-{{ primary }} rounded hover:bg-{{ primary_light }}">
                        Modifier
                      </Link>
{% endif %}
                      {% if has_delete %}
                      <button onClick={() => handleDelete(item.id)} className="px-3 py-1 text-xs font-medium text-red-600 border border-red-600 rounded hover:bg-red-50">
                        Supprimer
                      </button>
                      {% endif %}
                    </div>
                  </td>
                  {% endif %}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </main>
  )
}
