'use client'

import { useActionState } from 'react'
import Link from 'next/link'
import { create{{ name }} } from '{{ actions_import }}'
{% for fk in fk_fields %}
import type { Serialized{{ fk.related_model }} } from '@/lib/types'
{% endfor %}

{% if fk_fields %}
interface {{ client_name }}Props {
  {{ fk_props }}
}
{% endif %}

export default function {{ client_name }}({% if fk_fields %}{ {{ fk_destructure }} }: {{ client_name }}Props{% endif %}) {
  const [error, formAction, isPending] = useActionState(
    async (_prev: unknown, formData: FormData) => {
      try { await create{{ name }}(formData); return null }
      catch (e) { return (e as Error).message }
    },
    null,
  )

  return (
    <main className="container mx-auto p-6 max-w-xl">
      <div className="flex items-center gap-3 mb-6">
        <Link href="{{ list_path }}" className="text-gray-400 hover:text-gray-600">←</Link>
        <h1 className="text-2xl font-bold text-gray-900">Nouveau {{ name }}</h1>
      </div>

      {error && <p className="mb-4 text-sm text-red-600 bg-red-50 px-4 py-2 rounded">{error}</p>}

      <form action={formAction} className="space-y-4 bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        {% for field in editable_fields %}
        <div>
          <label htmlFor="{{ field.name }}" className="block text-sm font-medium text-gray-700 mb-1">
            {{ field_labels.get(field.name, field.name) }}{% if not field.is_optional and not field.has_default %} <span className="text-red-500">*</span>{% endif %}
          </label>
          {% if field.input_type == 'textarea' %}
          <textarea
            id="{{ field.name }}"
            name="{{ field.name }}"
            rows={4}
            {% if not field.is_optional and not field.has_default %}required{% endif %}
            className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          {% elif field.input_type == 'checkbox' %}
          <input
            type="checkbox"
            id="{{ field.name }}"
            name="{{ field.name }}"
            value="true"
            className="h-4 w-4 text-blue-600 border-gray-300 rounded"
          />
          {% elif field.input_type == 'enum-select' %}
          <select
            id="{{ field.name }}"
            name="{{ field.name }}"
            {% if not field.is_optional and not field.has_default %}required{% endif %}
            className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Sélectionner…</option>
            {% for val in field.enum_values %}
            <option value="{{ val }}">{{ field.enum_labels.get(val, val) }}</option>
            {% endfor %}
          </select>
          {% else %}
          <input
            type="{{ field.input_type }}"
            id="{{ field.name }}"
            name="{{ field.name }}"
            {% if not field.is_optional and not field.has_default %}required {% endif %}{% if field.input_type == 'number' %}step="any"{% endif %}
            className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          {% endif %}
        </div>
        {% endfor %}

        {% for fk in fk_fields %}
        <div>
          <label htmlFor="{{ fk.field_name }}" className="block text-sm font-medium text-gray-700 mb-1">
            {{ field_labels.get(fk.field_name, fk.related_model) }}
          </label>
          <select
            id="{{ fk.field_name }}"
            name="{{ fk.field_name }}"
            required
            className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">Sélectionner…</option>
            {{ '{' }}{{ fk.related_camel }}Options.map(opt => (
              <option key={opt.id} value={opt.id}>{String(opt.{{ fk.related_display }} ?? opt.id)}</option>
            ))}
          </select>
        </div>
        {% endfor %}

        <div className="flex gap-3 pt-2">
          <button
            type="submit"
            disabled={isPending}
            className="flex-1 px-6 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 disabled:opacity-50"
          >
            {isPending ? 'En cours…' : 'Créer'}
          </button>
          <Link
            href="{{ list_path }}"
            className="px-6 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50"
          >
            Annuler
          </Link>
        </div>
      </form>
    </main>
  )
}
