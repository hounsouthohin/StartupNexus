'use client'

import { useActionState } from 'react'
import Link from 'next/link'
import { create{{ name }} } from '{{ actions_import }}'
{% for tm in option_type_imports %}
import type { Serialized{{ tm }} } from '@/lib/types'
{% endfor %}

{% if fk_props %}
interface {{ client_name }}Props {
  {{ fk_props }}
}
{% endif %}

export default function {{ client_name }}({% if fk_props %}{ {{ fk_destructure }} }: {{ client_name }}Props{% endif %}) {
  const [error, formAction, isPending] = useActionState(
    async (_prev: unknown, formData: FormData) => {
      try { await create{{ name }}(formData); return null }
      catch (e) { return (e as Error).message }
    },
    null,
  )

  return (
    <main className="container mx-auto {{ p_cls }} max-w-xl">
      <div className="flex items-center gap-3 mb-6">
        <Link href="{{ list_path }}" className="text-muted-foreground hover:text-foreground">←</Link>
        <h1 className="text-2xl font-bold text-foreground">Créer {{ title_singular }}</h1>
      </div>

      {error && <p className="mb-4 text-sm text-red-600 bg-red-50 px-4 py-2 rounded">{error}</p>}

      <form action={formAction} className="space-y-4 {{ card_cls }} {{ p_cls }}">
        {% for field in editable_fields %}
        <div>
          <label htmlFor="{{ field.name }}" className="block text-sm font-medium text-foreground mb-1">
            {{ field_labels.get(field.name, field.name) }}{% if not field.is_optional and not field.has_default %} <span className="text-red-500">*</span>{% endif %}
          </label>
          {% if field.input_type == 'textarea' %}
          <textarea
            id="{{ field.name }}"
            name="{{ field.name }}"
            rows={{ '{' }}{{ 12 if field.name in ('content', 'body', 'instructions') else 4 }}}
            {% if not field.is_optional and not field.has_default %}required{% endif %}
            className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }}"
          />
          {% elif field.input_type == 'checkbox' %}
          <input
            type="checkbox"
            id="{{ field.name }}"
            name="{{ field.name }}"
            value="true"
            className="h-4 w-4 text-{{ primary }} border-border rounded"
          />
          {% elif field.input_type == 'enum-select' %}
          <select
            id="{{ field.name }}"
            name="{{ field.name }}"
            {% if not field.is_optional and not field.has_default %}required{% endif %}
            className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }}"
          >
            <option value="">Sélectionner…</option>
            {% for val in field.enum_values %}
            <option value="{{ val }}">{{ field.enum_labels.get(val, val) }}</option>
            {% endfor %}
          </select>
          {% else %}
          <input
            type="{{ field.input_type }}"
            id="{{ field.name }}"
            name="{{ field.name }}"
            {% if not field.is_optional and not field.has_default %}required {% endif %}{% if field.input_type == 'number' %}step="any"{% endif %}
            className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }}"
          />
          {% endif %}
        </div>
        {% endfor %}

        {% for fk in fk_fields %}
        <div>
          <label htmlFor="{{ fk.field_name }}" className="block text-sm font-medium text-foreground mb-1">
            {{ field_labels.get(fk.field_name, fk.related_model) }}
          </label>
          <select
            id="{{ fk.field_name }}"
            name="{{ fk.field_name }}"
            required
            className="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-{{ primary_ring }}"
          >
            <option value="">Sélectionner…</option>
            {{ '{' }}{{ fk.related_camel }}Options.map(opt => (
              <option key={opt.id} value={opt.id}>{String(opt.{{ fk.related_display }} ?? opt.id)}</option>
            ))}
          </select>
        </div>
        {% endfor %}

        {% for mf in m2m_fields %}
        <div>
          <span className="block text-sm font-medium text-foreground mb-1">{{ mf.label }}</span>
          <div className="max-h-40 overflow-y-auto border border-border rounded-md p-3 space-y-2">
            {{ '{' }}{{ mf.related_camel }}Options.length === 0 ? (
              <p className="text-sm text-muted-foreground">Aucun élément disponible.</p>
            ) : {{ mf.related_camel }}Options.map(opt => (
              <label key={opt.id} className="flex items-center gap-2 text-sm text-foreground">
                <input
                  type="checkbox"
                  name="{{ mf.input_name }}"
                  value={opt.id}
                  className="h-4 w-4 text-{{ primary }} border-border rounded"
                />
                <span>{String(opt.{{ mf.related_display }} ?? opt.id)}</span>
              </label>
            ))}
          </div>
        </div>
        {% endfor %}

        <div className="flex gap-3 pt-2">
          <button
            type="submit"
            disabled={isPending}
            className="flex-1 px-6 py-2 bg-{{ primary }} text-white rounded-md text-sm font-medium hover:bg-{{ primary_hover }} disabled:opacity-50"
          >
            {isPending ? 'En cours…' : 'Créer'}
          </button>
          <Link
            href="{{ list_path }}"
            className="px-6 py-2 border border-border rounded-md text-sm font-medium text-foreground hover:bg-muted/50"
          >
            Annuler
          </Link>
        </div>
      </form>
    </main>
  )
}
