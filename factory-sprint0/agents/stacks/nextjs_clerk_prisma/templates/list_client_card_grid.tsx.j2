'use client'

import { useState } from 'react'
import Link from 'next/link'
import type { {{ serialized_type }} } from '@/lib/types'
import { delete{{ name }} } from '@/app/{{ list_dir }}/actions'

interface {{ client_name }}Props {
  items: {{ serialized_type }}[]
}

export default function {{ client_name }}({ items }: {{ client_name }}Props) {
  const [list, setList] = useState(items)

  const handleDelete = async (id: string) => {
    if (!confirm('Supprimer cet élément ?')) return
    const result = await delete{{ name }}(id)
    if (result?.error) { alert(result.error); return }
    setList(prev => prev.filter(item => item.id !== id))
  }

  return (
    <main className="container mx-auto {{ p_cls }}">
      <div className="flex items-center justify-between mb-6">
        <h1 className="text-2xl font-bold text-foreground">{{ title_plural }}</h1>
        <Link
          href="{{ list_path }}/new"
          className="px-4 py-2 bg-{{ primary }} text-white rounded-md hover:bg-{{ primary_hover }} text-sm font-medium"
        >
          Nouveau
        </Link>
      </div>

      {list.length === 0 ? (
        <div className="text-center py-12 text-muted-foreground">
          <p className="text-lg">{{ empty_state_message if empty_state_message else "Aucun " + camel + " pour le moment." }}</p>
          <Link href="{{ list_path }}/new" className="mt-4 inline-block text-{{ primary }} hover:underline text-sm">
            Créer le premier
          </Link>
        </div>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {list.map(item => (
            <div
              key={item.id}
              className="{{ card_cls }} overflow-hidden {{ transition_cls }} hover:shadow-md group flex flex-col"
            >
              <div className="p-5 flex-1">
                {% if display_fields %}
                {% set primary_field = display_fields[0] %}
                <h2 className="text-base font-semibold text-foreground group-hover:text-{{ primary }} {{ transition_cls }} mb-2 line-clamp-2">
                  {String(item.{{ primary_field }} ?? '—')}
                </h2>
                {% for field in display_fields[1:3] %}
                <p className="text-sm text-muted-foreground mb-1 line-clamp-2">
                  <span className="font-medium">{{ field_labels.get(field, field) }} :</span>{' '}
                  {String(item.{{ field }} ?? '—')}
                </p>
                {% endfor %}
                {% endif %}
              </div>
              <div className="px-5 py-3 border-t border-border flex items-center justify-end gap-2">
                {% if has_detail %}
                <Link
                  href={`{{ list_path }}/{{ '${' }}{% if has_slug %}item.slug{% else %}item.id{% endif %}}`}
                  className="px-3 py-1 text-xs font-medium text-muted-foreground border border-border rounded hover:bg-muted/50 {{ transition_cls }}"
                >
                  Voir
                </Link>
                {% endif %}
                <Link
                  href={`{{ list_path }}/{{ '${' }}{% if has_slug %}item.slug{% else %}item.id{% endif %}}/edit`}
                  className="px-3 py-1 text-xs font-medium text-{{ primary }} border border-{{ primary }} rounded hover:bg-{{ primary_light }} {{ transition_cls }}"
                >
                  Modifier
                </Link>
                <button
                  onClick={() => handleDelete(item.id)}
                  className="px-3 py-1 text-xs font-medium text-red-600 border border-red-600 rounded hover:bg-red-50 {{ transition_cls }}"
                >
                  Supprimer
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </main>
  )
}
