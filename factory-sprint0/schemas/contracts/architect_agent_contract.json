{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architect Agent Contract v2.0",
  "description": "Contract d'interface pour l'Architect Agent (génération specs — Pré-Sprint 4.6 : diagrammer retiré du pipeline, mermaid_diagram optionnel)",
  "version": "2.0.0",
  "agent_id": "architect_agent",

  "input_schema": {
    "type": "object",
    "required": ["brief"],
    "additionalProperties": false,
    "properties": {
      "brief": {
        "type": "object",
        "description": "Brief structuré JSON décrivant le projet SaaS à créer",
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string",
            "description": "Description textuelle du projet",
            "minLength": 10,
            "maxLength": 2000
          },
          "models": {
            "type": "array",
            "description": "Modèles Prisma DSL verbatim (ex: 'Task { id String @id, title String, ... }')",
            "items": {"type": "string"},
            "default": []
          },
          "pages": {
            "type": "array",
            "description": "Pages Next.js app-router",
            "items": {
              "type": "object",
              "properties": {
                "path": {"type": "string"},
                "auth": {"type": "boolean"}
              },
              "required": ["path"]
            },
            "default": []
          },
          "routes": {
            "type": "array",
            "description": "Routes API",
            "items": {
              "type": "object",
              "properties": {
                "method": {"type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
                "path": {"type": "string"}
              },
              "required": ["method", "path"]
            },
            "default": []
          }
        }
      },
      "project_name": {
        "type": "string",
        "description": "Nom du projet (optionnel, auto-généré si absent)",
        "pattern": "^[a-z0-9-]+$",
        "examples": ["task-manager", "saas-crm"]
      },
      "stack_id": {
        "type": "string",
        "description": "Identifiant de stack (ex: nextjs-clerk-prisma)"
      },
      "run_id": {
        "type": "string",
        "description": "Identifiant du run (propagation observabilité)"
      }
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["specification", "requirements"],
    "additionalProperties": false,
    "properties": {
      "specification": {
        "type": "string",
        "description": "Résumé de la spec (Nouvelle Base : ProjectSpec remplace le texte libre)",
        "default": ""
      },
      "project_spec": {
        "type": "object",
        "description": "Nouvelle Base — ProjectSpec typé (instructor+Pydantic). Source de vérité unique pour le dev agent.",
        "properties": {
          "project_name": {"type": "string"},
          "stack_id": {"type": "string"},
          "models": {"type": "array"},
          "routes": {"type": "array"},
          "pages": {"type": "array"},
          "user_flows": {"type": "array"},
          "spec_fingerprint": {"type": "string"}
        },
        "default": {}
      },
      "spec_fingerprint": {
        "type": "string",
        "description": "Hash SHA256 (16 chars) des noms modèles + pages + routes — détection dérive",
        "default": ""
      },
      "mermaid_diagram": {
        "type": "string",
        "description": "Diagramme Mermaid (optionnel — diagrammer_node retiré du pipeline Pré-Sprint 4.6, conservé pour Sprint 6 dashboard)",
        "default": ""
      },
      "requirements": {
        "type": "array",
        "description": "Liste plate exhaustive des requirements extraits du brief (modèles, pages, routes, features)",
        "items": {"type": "string"},
        "default": []
      },
      "spec_validation_status": {
        "type": "string",
        "description": "Statut de cohérence requirements↔spec après SpecValidator : OK | DEGRADED | UNKNOWN"
      },
      "spec_unmatched_requirements": {
        "type": "array",
        "items": {"type": "string"},
        "description": "Requirements dont les termes-clés sont absents de la spec générée (dérive spec_writer détectée)"
      },
      "spec_forbidden_keywords": {
        "type": "array",
        "items": {"type": "string"},
        "description": "Mots-clés interdits (spec_validation.forbidden_keywords) détectés dans la spec générée",
        "default": []
      },
      "user_flows": {
        "type": "array",
        "description": "Liste des flux utilisateur extraits du brief (action → route/page). Utilisé par le Journey Validator.",
        "items": {"type": "string"},
        "default": []
      },
      "ir_schema": {
        "type": "array",
        "description": "IR canonique — modèles Prisma verbatim issus du parser déterministe.",
        "items": {"type": "string"},
        "default": []
      },
      "ir_pages": {
        "type": "array",
        "description": "IR canonique — chemins de pages Next.js app-router issus du parser déterministe.",
        "items": {"type": "string"},
        "default": []
      },
      "ir_routes": {
        "type": "array",
        "description": "IR canonique — fichiers de routes API issus du parser déterministe.",
        "items": {"type": "string"},
        "default": []
      },
      "spec_structured": {
        "type": "object",
        "description": "Dual-output P2 — version JSON structurée de la spec (déterministe, zéro LLM). specification: str reste le contrat garanti.",
        "properties": {
          "spec_summary": {"type": "string"},
          "entities_in_spec": {"type": "array", "items": {"type": "string"}},
          "missing_entities": {"type": "array", "items": {"type": "string"}},
          "pages_in_spec": {"type": "array", "items": {"type": "string"}},
          "routes_in_spec": {"type": "array", "items": {"type": "string"}}
        },
        "default": {}
      },
      "metadata": {
        "type": "object",
        "properties": {
          "rag_standards_used": {
            "type": "integer",
            "description": "Nombre de standards RAG utilisés"
          },
          "generation_time_seconds": {
            "type": "number",
            "description": "Temps de génération en secondes"
          }
        }
      }
    }
  },

  "error_schema": {
    "type": "object",
    "required": ["code", "message"],
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "RAG_CONNECTION_ERROR",
          "LLM_ERROR",
          "TIMEOUT_ERROR"
        ]
      },
      "message": {"type": "string"},
      "details": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "failed_step": {
            "type": "string",
            "enum": ["retrieval", "planner"]
          },
          "raw_error": {"type": "string"}
        }
      }
    }
  },

  "health_schema": {
    "type": "object",
    "required": ["status"],
    "additionalProperties": false,
    "properties": {
      "status": {
        "type": "string",
        "enum": ["healthy", "degraded", "unhealthy"]
      },
      "checks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rag_connection": {"type": "boolean"},
          "llm_available": {"type": "boolean"}
        }
      },
      "last_check": {"type": "string", "format": "date-time"}
    }
  }
}
