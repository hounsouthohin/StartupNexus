{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dev Agent Contract v1.0",
  "description": "Contract d'interface pour le Dev Agent (génération code Next.js)",
  "version": "1.1.0",
  "agent_id": "dev_agent",

  "input_schema": {
    "type": "object",
    "required": ["spec", "mermaid", "project_name"],
    "additionalProperties": false,
    "properties": {
      "spec": {
        "type": "string",
        "description": "Spécification technique Markdown de l'Architect Agent",
        "minLength": 100
      },
      "mermaid": {
        "type": "string",
        "description": "Diagramme Mermaid de l'Architect Agent (optionnel — diagrammer_node retiré Pré-Sprint 4.6)",
        "default": ""
      },
      "project_name": {
        "type": "string",
        "description": "Nom du projet",
        "pattern": "^[a-z0-9-]+$"
      },
      "stack_id": {
        "type": "string",
        "description": "Identifiant de stack (ex: nextjs-clerk-prisma)"
      },
      "run_id": {
        "type": "string",
        "description": "Identifiant du run (propagation observabilité)"
      },
      "requirements": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Requirements extraits par l'Architect — utilisés comme contraintes de génération"
      },
      "spec_validation_status": {
        "type": "string",
        "description": "Statut de cohérence requirements↔spec : OK | DEGRADED | UNKNOWN"
      },
      "spec_unmatched_requirements": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Requirements dont les termes-clés sont absents de la spec générée (dérive spec_writer)"
      },
      "user_flows": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Flux utilisateur extraits par l'Architect — transmis au Journey Validator",
        "default": []
      }
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["files", "final_message", "success"],
    "additionalProperties": false,
    "properties": {
      "files": {
        "type": "object",
        "description": "Dictionnaire des fichiers générés {path: content}",
        "patternProperties": {
          ".*": {"type": "string"}
        }
      },
      "final_message": {
        "type": "string",
        "description": "Statut final canonique T005 — jamais texte LLM",
        "enum": ["BUILD_SUCCESS", "BUILD_FAILED", "MAX_ITER_REACHED", "NOT_BUILT_BY_GATE"]
      },
      "success": {
        "type": "boolean",
        "description": "True si build Next.js réussi"
      },
      "metadata": {
        "type": "object",
        "additionalProperties": false,
          "properties": {
            "iterations": {"type": "integer"},
            "build_attempts": {"type": "integer"},
            "build_attempted": {"type": "boolean"},
            "total_files": {"type": "integer"},
            "last_build_error": {"type": "string"},
            "last_build_error_full": {"type": "string"},
            "last_test_error": {"type": "string"},
            "last_test_error_full": {"type": "string"},
            "last_failed_command": {"type": "string"},
            "gate_source": {"type": "string", "description": "Source du gate ayant bloqué : structural | requirements | no_files | ''"},
            "blocking_guard_id": {"type": "string", "description": "ID du content guard ayant bloqué le build"},
            "gate_message": {"type": "string", "description": "Extrait du message gate final (observabilité)"},
            "missing_required_files": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Fichiers blueprint manquants lors du dernier gate structural"
            },
            "guard_warning_hits": {
              "type": "object",
              "description": "Nombre de hits par guard en mode warn (observabilité faux positifs)",
              "additionalProperties": {"type": "integer"}
            },
            "guard_warning_count": {"type": "integer", "description": "Total des hits guards warn"},
            "supervisor_files_reviewed": {"type": "integer"},
            "supervisor_corrections_count": {"type": "integer"},
            "conformity_score": {"type": "number", "minimum": 0, "maximum": 1},
            "security_score": {"type": "number", "minimum": 0, "maximum": 1},
            "architecture_score": {"type": "number", "minimum": 0, "maximum": 1},
            "build_corrections_count": {"type": "integer"},
            "supervision_loop_corrections": {"type": "integer", "description": "Nombre total de corrections superviseur injectées dans la boucle"},
            "supervision_loop_pending_at_end": {"type": "integer", "description": "Nombre de fichiers avec corrections superviseur encore en attente à la fin du run"}
          }
      }
    }
  },

  "error_schema": {
    "type": "object",
    "required": ["code", "message"],
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "BUILD_ERROR",
          "SYNTAX_ERROR",
          "DEPENDENCY_ERROR",
          "TIMEOUT_ERROR"
        ]
      },
      "message": {"type": "string"},
      "details": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "failed_files": {
            "type": "array",
            "items": {"type": "string"}
          },
          "build_logs": {"type": "string"}
        }
      }
    }
  },

  "health_schema": {
    "type": "object",
    "required": ["status"],
    "additionalProperties": false,
    "properties": {
      "status": {
        "type": "string",
        "enum": ["healthy", "degraded", "unhealthy"]
      },
      "checks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tools_available": {"type": "boolean"},
          "rag_connection": {"type": "boolean"}
        }
      },
      "last_check": {"type": "string", "format": "date-time"}
    }
  }
}
