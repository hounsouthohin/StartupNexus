{
  "agent_name": "dev_test_agent",
  "version": "1.1.0",
  "mode": "fusion",
  "description": "Contrat fusionné Dev+Test (Sprints 0.5-3) — T006: run_metric ajouté, final_message canonique T005",

  "input_schema": {
    "type": "object",
    "required": ["spec", "mermaid", "project_name"],
    "additionalProperties": false,
    "properties": {
      "spec":         { "type": "string" },
      "mermaid":      { "type": "string" },
      "project_name": { "type": "string" },
      "stack_id":     { "type": "string" },
      "run_id":       { "type": "string" },
      "requirements": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Requirements extraits par l'Architect — utilisés pour compute_spec_coverage"
      },
      "spec_validation_status": {
        "type": "string",
        "description": "Statut de cohérence requirements↔spec : OK | DEGRADED | UNKNOWN"
      },
      "spec_unmatched_requirements": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Requirements dont les termes-clés sont absents de la spec (dérive spec_writer)"
      }
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["dev_output", "combined_files", "success"],
    "additionalProperties": false,
    "properties": {
      "final_message": {
        "type": "string",
        "description": "Message final canonique du dev loop (MAX_ITER_REACHED, NOT_BUILT_BY_GATE, BUILD_SUCCESS, etc.)"
      },
      "dev_output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "files":         { "type": "object" },
          "final_message": { "type": "string" },
          "success":       { "type": "boolean" },
          "metadata":      { "type": "object" }
        }
      },
      "test_output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tests":   { "type": "object" },
          "success": { "type": "boolean" }
        }
      },
      "combined_files": { "type": "object" },
      "success":        { "type": "boolean" },
      "semantic_violations": { "type": "array", "items": { "type": "string" } },
      "run_metric": {
        "type": "object",
        "description": "Métriques runtime calculées par dev_test_activity (T006)",
        "properties": {
          "build_success":        { "type": "boolean" },
          "build_attempted":      { "type": "boolean" },
          "files_count":          { "type": "integer" },
          "clerk_compliant":      { "type": "boolean" },
          "dev_files_count":      { "type": "integer" },
          "build_attempts":       { "type": "integer" },
          "iterations":           { "type": "integer" },
          "final_message":        { "type": "string" },
          "last_build_error":     { "type": "string" },
          "last_build_error_full":{ "type": "string" },
          "last_test_error":      { "type": "string" },
          "last_test_error_full": { "type": "string" },
          "last_failed_command":  { "type": "string" },
          "semantic_violations":  { "type": "array", "items": { "type": "string" } },
          "error":                { "type": ["string", "null"] },
          "root_cause_category":  { "type": "string" },
          "blocking_guard_id":    { "type": "string" },
          "gate_message":         { "type": "string" },
          "gate_source":          { "type": "string" },
          "missing_required_files": { "type": "array", "items": { "type": "string" } }
        }
      },
      "metadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "total_files":          { "type": "integer" },
          "mode":                 { "type": "string" },
          "dev_files_count":      { "type": "integer" },
          "test_files_count":     { "type": "integer" },
          "tests_passed":         { "type": "boolean" },
          "spec_coverage":        { "type": "number", "minimum": 0, "maximum": 1 },
          "requirements_met":     { "type": "integer" },
          "requirements_total":   { "type": "integer" },
          "requirements_unmet":          { "type": "array", "items": { "type": "string" } },
          "requirements_unmet_by_category": { "type": "object" },
          "spec_validation_status":       { "type": "string" },
          "spec_unmatched_count":         { "type": "integer" }
        }
      }
    }
  },

  "error_schema": {
    "type": "object",
    "required": ["success", "error"],
    "additionalProperties": false,
    "properties": {
      "success": { "type": "boolean", "enum": [false] },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "phase":   { "type": "string", "enum": ["dev", "test"] },
          "message": { "type": "string" }
        }
      },
      "combined_files": { "type": "object" }
    }
  },

  "health_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "status": { "type": "string", "enum": ["healthy", "degraded"] },
      "mode":   { "type": "string", "enum": ["fusion", "split"] },
      "checks": { "type": "object" }
    }
  }
}