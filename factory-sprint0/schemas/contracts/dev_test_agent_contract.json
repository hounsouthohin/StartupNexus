{
  "agent_name": "dev_test_agent",
  "version": "1.0.0",
  "mode": "fusion",
  "description": "Contrat fusionné Dev+Test (Sprints 0.5-3)",

  "input_schema": {
    "type": "object",
    "required": ["spec", "mermaid", "project_name"],
    "additionalProperties": false,
    "properties": {
      "spec":         { "type": "string" },
      "mermaid":      { "type": "string" },
      "project_name": { "type": "string" },
      "stack_id":     { "type": "string" },
      "run_id":       { "type": "string" },
      "requirements": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Requirements extraits par l'Architect — utilisés pour compute_spec_coverage"
      },
      "spec_validation_status": {
        "type": "string",
        "description": "Statut de cohérence requirements↔spec : OK | DEGRADED | UNKNOWN"
      },
      "spec_unmatched_requirements": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Requirements dont les termes-clés sont absents de la spec (dérive spec_writer)"
      }
    }
  },

  "output_schema": {
    "type": "object",
    "required": ["dev_output", "combined_files", "success"],
    "properties": {
      "dev_output": {
        "type": "object",
        "properties": {
          "files":         { "type": "object" },
          "final_message": { "type": "string" },
          "success":       { "type": "boolean" }
        }
      },
      "test_output": {
        "type": "object",
        "properties": {
          "tests":   { "type": "object" },
          "success": { "type": "boolean" }
        }
      },
      "combined_files": { "type": "object" },
      "success":        { "type": "boolean" },
      "metadata": {
        "type": "object",
        "properties": {
          "total_files":          { "type": "integer" },
          "mode":                 { "type": "string" },
          "dev_files_count":      { "type": "integer" },
          "test_files_count":     { "type": "integer" },
          "tests_passed":         { "type": "boolean" },
          "spec_coverage":        { "type": "number", "minimum": 0, "maximum": 1 },
          "requirements_met":     { "type": "integer" },
          "requirements_total":   { "type": "integer" },
          "requirements_unmet":          { "type": "array", "items": { "type": "string" } },
          "requirements_unmet_by_category": { "type": "object" },
          "spec_validation_status":       { "type": "string" },
          "spec_unmatched_count":         { "type": "integer" }
        }
      }
    }
  },

  "error_schema": {
    "type": "object",
    "required": ["success", "error"],
    "properties": {
      "success": { "type": "boolean", "enum": [false] },
      "error": {
        "type": "object",
        "properties": {
          "phase":   { "type": "string", "enum": ["dev", "test"] },
          "message": { "type": "string" }
        }
      },
      "combined_files": { "type": "object" }
    }
  },

  "health_schema": {
    "type": "object",
    "properties": {
      "status": { "type": "string", "enum": ["healthy", "degraded"] },
      "mode":   { "type": "string", "enum": ["fusion", "split"] },
      "checks": { "type": "object" }
    }
  }
}