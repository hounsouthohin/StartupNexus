{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StackConfig",
  "type": "object",
  "required": [
    "id",
    "stack_id",
    "framework",
    "status",
    "blueprint"
  ],
  "properties": {
    "id": { "type": "string" },
    "stack_id": { "type": "string" },
    "framework": { "type": "string" },
    "status": { "enum": ["stable", "experimental", "deprecated"] },
    "llm_models": {
      "type": "object",
      "description": "Override des modèles LLM par stack (optionnel).",
      "properties": {
        "architect_base": { "type": "string" },
        "architect_planner": { "type": "string" }
      },
      "additionalProperties": true
    },
    "templated_files": {
      "type": "object",
      "description": "Fichiers gérés par templates (non modifiables par le LLM) : {dest: template_rel_path}",
      "additionalProperties": { "type": "string" }
    },
    "spec_validation": {
      "type": "object",
      "description": "Règles de validation de la spec générée par l'Architect",
      "properties": {
        "required_keywords": { "type": "array", "items": { "type": "string" } },
        "forbidden_keywords": { "type": "array", "items": { "type": "string" } },
        "required_sections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "forbidden_auth_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Patterns interdits dans la spec et le code générés (auth custom)"
    },
    "blueprint": {
      "type": "object",
      "required": ["required_files"],
      "properties": {
        "required_files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "optional_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
