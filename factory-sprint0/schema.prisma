datasource db {  
  provider = "postgresql"  
  url      = env("DATABASE_URL")  
}  

generator client {  
  provider = "prisma-client-js"  
}  

model User {  
  id        String   @id @default(uuid())  
  email     String   @unique  
  name      String?  
  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt  
  profiles   Profile[]  
  subscriptions Subscription[]  
}  

model Profile {  
  id     String @id @default(uuid())  
  userId String  
  avatar  String?  
  bio    String?  
  user   User @relation(fields: [userId], references: [id])  
}  

model Subscription {  
  id        String   @id @default(uuid())  
  userId    String   
  plan      String   
  status     String   
  user      User @relation(fields: [userId], references: [id])  
}  
