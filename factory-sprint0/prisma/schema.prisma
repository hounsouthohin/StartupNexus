datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  projects   Project[]
}

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  tasks     Task[]
  users     User[]
}

model Task {
  id        Int      @id @default(autoincrement())
  title     String
  description String?
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])
}