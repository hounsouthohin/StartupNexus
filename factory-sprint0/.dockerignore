.git
.gitignore

# Python cache / test artifacts
__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp/
.pytest_tmp*/
tmp_pytest*/
tmp_pytest_*/

# Local venvs / editors
.venv/
venv/
.vscode/

# Runtime/generated artifacts not needed in image build context
logs/
generated-projects/
run/_pytest_tmp*/
tmp*/

# OS-specific noise
Thumbs.db
Desktop.ini
