{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "plugins": ["import"],
  "rules": {
    "import/no-relative-packages": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@clerk/nextjs",
            "importNames": ["auth"],
            "message": "Server-side auth() doit venir de @clerk/nextjs/server."
          },
          {
            "name": "@clerk/nextjs",
            "importNames": ["clerkMiddleware"],
            "message": "middleware.ts doit importer clerkMiddleware depuis @clerk/nextjs/server."
          }
        ],
        "patterns": [
          "bcrypt",
          "jsonwebtoken",
          "next-auth",
          "passport",
          "react-hook-form",
          "shadcn/ui",
          "@shadcn/ui"
        ]
      }
    ]
  }
}
