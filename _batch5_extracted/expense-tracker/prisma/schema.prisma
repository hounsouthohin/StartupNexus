generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id              // Clerk userId (ex: user_xxx)
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}


model Expense {
  id String @id @default(uuid())
  amount Float
  description String?
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId String
  createdAt DateTime @default(now())
}

model Category {
  id String @id @default(uuid())
  name String
  userId String
  expenses Expense[]
  createdAt DateTime @default(now())
}
