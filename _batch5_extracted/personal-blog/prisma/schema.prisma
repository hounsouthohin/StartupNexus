generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  draft
  published
}

model Post {
  id String @id @default(uuid())
  title String
  excerpt String
  status PostStatus @default(draft)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId String
  createdAt DateTime @default(now())
}

model Category {
  id String @id @default(uuid())
  name String
  authorId String
  posts Post[]
  createdAt DateTime @default(now())
}
